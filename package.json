{
  "name": "deep-fryer",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @deep-fryer/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "create-tenant": "tsx scripts/create-tenant.ts",
    "import-santa-cruz": "tsx scripts/import-santa-cruz.ts",
    "test": "pnpm -r --if-present test"
  },
  "dependencies": {
    "@deep-fryer/core": "workspace:*",
    "@deep-fryer/db": "workspace:*",
    "@supabase/supabase-js": "^2.46.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
