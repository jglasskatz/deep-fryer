{
  "name": "deep-fryer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @deep-fryer/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "create-tenant": "tsx scripts/create-tenant.ts",
    "import-santa-cruz": "tsx scripts/import-santa-cruz.ts",
    "research-verify": "tsx scripts/research-verify.ts",
    "test": "pnpm -r --if-present test",
    "export:nyc": "tsx scripts/export-nyc.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "provision:nyc": "tsx scripts/provision-nyc.ts",
    "pages:snapshot": "node --env-file=.env.local --import tsx scripts/snapshot-pages.ts",
    "pages:build": "node scripts/build-pages.mjs",
    "pages:test": "node --import tsx --test scripts/campaign-snapshot.test.mjs scripts/preview-observation.test.mjs scripts/pages-contract.test.mjs scripts/keel-path.test.mjs scripts/estimate-research-costs.test.mjs scripts/research-overlays.test.mjs",
    "pages:check": "node scripts/check-pages.mjs && node scripts/check-pages-ui.mjs",
    "pages:amend": "node scripts/apply-research-overlays.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@deep-fryer/contract": "workspace:*",
    "@deep-fryer/core": "workspace:*",
    "@deep-fryer/db": "workspace:*",
    "@deep-fryer/research": "workspace:*",
    "@keel_flow/core": "^0.2.0",
    "@keel_flow/pack-agent-topology": "^0.2.0",
    "@keel_flow/pack-general-se": "^0.2.0",
    "@keel_flow/pack-research": "workspace:^",
    "@keel_flow/schema": "^0.2.0",
    "drizzle-orm": "^0.36.4",
    "nodemailer": "^10.0.13",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@keel_flow/cli": "^0.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "@keel_flow/pack-general-se@0.2.0": "patches/@keel_flow__pack-general-se@0.2.0.patch"
    }
  }
}
