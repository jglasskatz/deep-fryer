# Postgres (plain local Postgres works; Supabase in production)
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# Supabase (auth + storage; optional locally — dev mode without it)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of the web app (used by the embed for outbound links)
NEXT_PUBLIC_APP_URL=

# Research plane (worker)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
WORKER_CONCURRENCY=1
# OPEN_DOUGHNUT_PLUGIN_DIR=   # set by the worker image; defaults to vendor/ in the monorepo
# CHROMIUM_PATH=              # Playwright browser for evidence capture
