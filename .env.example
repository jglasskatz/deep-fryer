# deep-fryer configuration. Two uses, two halves:
#
# * Local development (docs/local-setup.md): copy to apps/web/.env.local. The
#   first half, "Local development only", is what a laptop needs — or nothing
#   at all, for the bundled demo portrait.
# * A docker compose deployment (docs/deploy.md): copy to .env next to
#   docker-compose.yml and fill in the second half, "Deployment". Compose
#   ignores the first half: it builds the database and storage settings for
#   its own services.
#
# Production refuses to start without the values marked "required"
# (packages/core/src/deploy-env.ts); the preflight checks the rest.

# ==== Local development only (docker compose ignores this half) ===============

# ---- Database ----------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deep_fryer_dev
# Migrations run as the owner; defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=

# ---- Evidence storage (S3-compatible; optional) -------------------------------
# Without it, evidence lands in apps/web/public/evidence/<tenant>/. Compose
# points these at its bundled SeaweedFS itself (it reads only S3_BUCKET, as
# that bucket's name); for Spaces or S3 in a deployment, see docs/deploy.md §3.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public base URL objects are served from (compose: ${APP_URL}/files).
S3_PUBLIC_URL=

# ---- Research key, as the web app knows it ------------------------------------
# The web app never sees ANTHROPIC_API_KEY; this says the worker has one.
# docker compose derives it from ANTHROPIC_API_KEY and ignores a value set
# here. Outside compose, set it to true when the worker you run has a key, or
# plan-funded research is refused before it starts.
# DF_RESEARCH_KEY_CONFIGURED=true

# ---- Tests and tooling --------------------------------------------------------
# Tests/CI only: send Stripe calls to stripe-mock (http://localhost:12111).
# Refused in production and never used with a live key.
# STRIPE_API_BASE=
# OPEN_DOUGHNUT_PLUGIN_DIR=   # set by the images; defaults to vendor/ in the monorepo
# CHROMIUM_PATH=              # Playwright browser for evidence capture

# ==== Deployment (docker compose reads these; local development may too) =====

# ---- Public URL (required in production) --------------------------------------
# The DNS name Caddy serves and gets the certificate for (compose only). On a
# port other than 443, include it (app.example.gov:8443; docs/deploy.md §3).
SITE_ADDRESS=app.example.gov
# The https origin people use (https://<SITE_ADDRESS>); also Auth.js's
# AUTH_URL. Local development: http://localhost:3000.
APP_URL=http://localhost:3000

# ---- Accounts (Auth.js) -------------------------------------------------------
# Required in production. Without it, development runs in dev mode (every
# request acts as an owner). Generate: openssl rand -base64 32
AUTH_SECRET=
# At least one sign-in method in production:
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Microsoft Entra ID (Microsoft 365 work accounts). Issuer defaults to the
# multi-tenant endpoint; pin your directory: https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Email magic links + invitations + notifications (any SMTP relay).
# smtps://user:pass@smtp.example.gov:465 — dev without it prints links to the log.
SMTP_URL=
# The sender: an address on a domain your relay may send for (its SPF and
# DKIM records), or mail is refused or lands in spam. The example.gov below is
# a placeholder; the preflight warns while it is still here.
EMAIL_FROM="deep-fryer <no-reply@example.gov>"
# Required in production: where people write for help — the site footer,
# error pages, and every "nothing was charged, contact …" message. A plain
# address (help@yourcity.gov); pages link it as mailto:.
SUPPORT_EMAIL=

# ---- The public site ----------------------------------------------------------
# Optional: your terms of use (https URL); the footer links "Terms" to it.
# TERMS_URL=
# Optional: the organization slug (as in /o/<slug>) the landing page
# showcases. Unset, or with no published portrait yet: no showcase, and the
# landing page lists the deployment's public portraits.
# DF_SHOWCASE_ORG=

# ---- Features (SPEC-v7 §3) -----------------------------------------------------
# Portrait owners turn features on in Settings; this switches features off for
# the whole deployment, whatever the portraits say (comma-separated):
# emergency, policy_analysis, involvement, discussion, translation,
# family_compare, request_research, deep_fry, and self_serve (public sign-up
# at /start and every "build your city's doughnut" link; off for a
# sales-led deployment, where staff create organizations).
# DF_DISABLED_FEATURES=

# ---- Billing (Stripe; optional) -------------------------------------------------
# Set both or neither. Without them, organizations run on staff-set contracts.
# There is no free trial: building a portrait needs a plan or a contract.
# Provision products/prices/portal/webhook through the ops container
# (docs/deploy.md §5).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Research plane (worker) ----------------------------------------------------
# The deployment's Anthropic API key: pays for every research session a plan
# funds. Required unless every organization brings its own key — without it,
# plan-funded research is refused (nothing is charged) and only organizations
# with their own key can build.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Model pins (docs/deploy.md "Models"). docker-compose.yml holds the defaults
# shown; uncomment a line only to change it — an empty value gets the default.
# The page reader: Claude Code's WebFetch summarizes every fetched page with
# this model, for the researchers and the verifier alike. Pinned so an SDK
# update cannot swap it silently. A first-party API id: behind Bedrock,
# Vertex, Foundry or an LLM gateway, set your provider's id for the model.
# ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4-5-20251001
# The verifier: one session per indicator finding, judging its source.
# VERIFIER_MODEL=claude-opus-5
# source-scout subagents under each researcher; empty = scouts off.
# RESEARCH_SUBAGENT_MODEL=
# Dimension sessions one research run keeps going at once.
# RESEARCH_SESSION_CONCURRENCY=3
WORKER_CONCURRENCY=1
# The worker's egress proxy (docs/deploy.md "Worker egress"), e.g.
# http://egress.internal:3128: an https forward proxy you run that logs every
# request and enforces your egress policy. Compose routes the research traffic
# through it — model calls, page reads, evidence captures, source checks.
# Unset, the worker reaches the internet directly, limited only by its
# in-code guard (https only, public addresses only).
# WORKER_HTTPS_PROXY=
# Bring-your-own-key (optional; SPEC-v7 §4): organization owners may store
# their own Anthropic API key on the billing page, and their research and
# policy sessions then run on it (a plan or contract is still needed). Stored
# keys are encrypted (AES-256-GCM) with this 32-byte key; web encrypts, only
# the worker decrypts — set the same value on both. Unset: research runs on
# ANTHROPIC_API_KEY only. Changing it makes stored keys unreadable (their
# owners enter them again). Generate: openssl rand -base64 32
DF_SECRETS_KEY=

# ---- Database and storage (docker compose only) ---------------------------------
POSTGRES_PASSWORD=
# Connections in each web or worker process's one pool (docs/deploy.md
# "Database connections"); docker-compose.yml passes it to the containers.
# DATABASE_POOL_MAX=10
# Evidence store credentials for the bundled SeaweedFS (letters, digits, . _ -):
# openssl rand -hex 32
STORAGE_ACCESS_KEY=deepfryer
STORAGE_SECRET_KEY=
