# deep-fryer configuration. Local development needs only DATABASE_URL (or
# nothing, for the bundled demo portrait); production refuses to start
# without the "required in production" values (apps/web/lib/env.ts).

# ---- Database ----------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deep_fryer_dev
# Migrations run as the owner; defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=
# Connections in each web or worker process's one pool (docs/deploy.md
# "Database connections"); docker-compose.yml passes it to the containers.
# DATABASE_POOL_MAX=10

# ---- Public URL (required in production) --------------------------------------
# The https origin people use; also Auth.js's AUTH_URL.
APP_URL=http://localhost:3000

# ---- Accounts (Auth.js) -------------------------------------------------------
# Required in production. Without it, development runs in dev mode (every
# request acts as an owner). Generate: openssl rand -base64 32
AUTH_SECRET=
# At least one sign-in method in production:
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Microsoft Entra ID (Microsoft 365 work accounts). Issuer defaults to the
# multi-tenant endpoint; pin your directory: https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Email magic links + invitations + notifications (any SMTP relay).
# smtps://user:pass@smtp.example.gov:465 — dev without it prints links to the log.
SMTP_URL=
EMAIL_FROM="deep-fryer <no-reply@example.gov>"
# Shown on pricing/billing for procurement questions (optional).
SUPPORT_EMAIL=

# ---- Billing (Stripe; optional) -------------------------------------------------
# Set both or neither. Without them, organizations run on staff-set contracts.
# Provision products/prices/portal/webhook: pnpm stripe:setup --prices docs/billing/prices.json
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Tests/CI only: send Stripe calls to stripe-mock (http://localhost:12111).
# Refused in production and never used with a live key.
# STRIPE_API_BASE=

# ---- Evidence storage (S3-compatible; optional locally) -----------------------
# SeaweedFS (compose sets these itself), DigitalOcean Spaces, or AWS S3. Without it, evidence lands
# in apps/web/public/evidence/<tenant>/.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public base URL objects are served from (compose: ${APP_URL}/files).
S3_PUBLIC_URL=

# ---- Research plane (worker) ----------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Model pins (docs/deploy.md "Models"). docker-compose.yml holds the defaults
# shown; uncomment a line only to change it — an empty value gets the default.
# The page reader: Claude Code's WebFetch summarizes every fetched page with
# this model, for the researchers and the verifier alike. Pinned so an SDK
# update cannot swap it silently. A first-party API id: behind Bedrock,
# Vertex, Foundry or an LLM gateway, set your provider's id for the model.
# ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4-5-20251001
# The verifier: one session per indicator finding, judging its source.
# VERIFIER_MODEL=claude-opus-5
# source-scout subagents under each researcher; empty = scouts off.
# RESEARCH_SUBAGENT_MODEL=
# Dimension sessions one research run keeps going at once.
# RESEARCH_SESSION_CONCURRENCY=3
WORKER_CONCURRENCY=1
# Bring-your-own-key (optional; SPEC-v7 §4): organization owners may store
# their own Anthropic API key on the billing page, and their research and
# policy sessions then run on it. Stored keys are encrypted (AES-256-GCM) with
# this 32-byte key; web encrypts, only the worker decrypts — set the same
# value on both. Unset: research runs on ANTHROPIC_API_KEY only. Changing it
# makes stored keys unreadable (their owners enter them again).
# Generate: openssl rand -base64 32
DF_SECRETS_KEY=
# OPEN_DOUGHNUT_PLUGIN_DIR=   # set by the images; defaults to vendor/ in the monorepo
# CHROMIUM_PATH=              # Playwright browser for evidence capture

# ---- Features (SPEC-v7 §3) -------------------------------------------------------
# Portrait owners turn features on in Settings; this switches features off for
# the whole deployment, whatever the portraits say (comma-separated):
# emergency, policy_analysis, involvement, discussion, translation,
# family_compare, request_research, deep_fry.
# DF_DISABLED_FEATURES=

# ---- docker compose only ----------------------------------------------------------
SITE_ADDRESS=app.example.gov
POSTGRES_PASSWORD=
# Evidence store credentials for the bundled SeaweedFS (letters, digits, . _ -):
# openssl rand -hex 32
STORAGE_ACCESS_KEY=deepfryer
STORAGE_SECRET_KEY=
