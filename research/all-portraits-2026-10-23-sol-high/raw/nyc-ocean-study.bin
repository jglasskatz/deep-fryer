hiddenText":13},{"text":339,"url":340,"target":86,"ariaLabel":28},"Frontiers Twitter","https://twitter.com/frontiersin","Twitter",{"link":343,"type":333,"color":334,"icon":346,"size":336,"hiddenText":13},{"text":344,"url":345,"target":86,"ariaLabel":28},"Frontiers LinkedIn","https://www.linkedin.com/company/frontiers","LinkedIn",{"link":348,"type":333,"color":334,"icon":351,"size":336,"hiddenText":13},{"text":349,"url":350,"target":86,"ariaLabel":28},"Frontiers Instagram","https://www.instagram.com/frontiersin_","Instagram","Frontiers Media SA. All rights reserved.","https://www.frontiersin.org/legal/terms-and-conditions","https://www.frontiersin.org/legal/privacy-policy","https://www.frontiersin.org/about/accessibility-statement",{},false,{"__typename":359,"identifier":124,"name":125,"slug":126,"banner":360,"description":422,"mission":423,"palette":424,"impactFactor":425,"citeScore":426,"citations":427,"showTagline":28,"twitter":428},"Journal",[361],{"id":362,"src":363,"name":364,"tags":365,"type":380,"width":381,"height":382,"idHash":383,"archive":384,"brandId":385,"limited":384,"fileSize":386,"isPublic":387,"original":388,"copyright":389,"extension":390,"thumbnails":392,"dateCreated":400,"description":401,"orientation":402,"userCreated":403,"watermarked":384,"dateModified":400,"datePublished":404,"ecsArchiveFiles":405,"propertyOptions":406,"property_Channel":411,"property_Sub-Type":413,"property_Asset_Type":415,"activeOriginalFocusPoint":417,"property_Office_Department":420},"AB731B5E-557C-4DEA-88680B655CE21F43","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/AB731B5E-557C-4DEA-88680B655CE21F43/webimage-1EF4D612-84E1-4D62-93F35B2F4CEA3949.png","FMARS_Main Visual_Cyan_Website",[366,367,368,369,370,371,372,373,374,375,376,377,378,379],"Megaptera Novaeangliae","Whale","Danita Delimont","Blue","Wildlife","Humpback Whale","RF","Pacific Ocean","Baleen","Breaching","Stuart Westmorland","Lanai","Usa","Hawaii","image",5760,3840,"6697d5d20c4e57f6",0,"22C10171-81B3-4DA6-99342F272A32E8BB",14818508,1,"https://brand.frontiersin.org/m/6697d5d20c4e57f6/original/FMARS_Main-Visual_Cyan_Website.jpg","Copyright © Robin Westmorland / Danita Delimont",[391],"jpg",{"mini":393,"thul":394,"webimage":363,"Guidelines":395,"WebsiteJpg_XL":396,"WebsiteWebP_L":397,"WebsiteWebP_M":398,"WebsiteWebP_XL":399},"https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/AB731B5E-557C-4DEA-88680B655CE21F43/mini-27409EC6-0151-4F4A-953B830157E0F792.png","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/AB731B5E-557C-4DEA-88680B655CE21F43/thul-725E5077-AECB-4796-85B60409AC983F4C.png","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/AB731B5E-557C-4DEA-88680B655CE21F43/9C3665D1-80E8-44FC-A115BB703255BBC3/Guidelines-FMARS_Main Visual_Cyan_Website.png","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/AB731B5E-557C-4DEA-88680B655CE21F43/9C3665D1-80E8-44FC-A115BB703255BBC3/WebsiteJpg_XL-FMARS_Main Visual_Cyan_Website.jpg","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/AB731B5E-557C-4DEA-88680B655CE21F43/9C3665D1-80E8-44FC-A115BB703255BBC3/WebsiteWebP_L-FMARS_Main Visual_Cyan_Website.webp","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/AB731B5E-557C-4DEA-88680B655CE21F43/9C3665D1-80E8-44FC-A115BB703255BBC3/WebsiteWebP_M-FMARS_Main Visual_Cyan_Website.webp","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/AB731B5E-557C-4DEA-88680B655CE21F43/9C3665D1-80E8-44FC-A115BB703255BBC3/WebsiteWebP_XL-FMARS_Main Visual_Cyan_Website.webp","2022-06-27T10:00:00Z","Humpback Whales (Megaptera novaeangliae) near Lanai Island, Hawaii, USA","landscape","Caroline Sutter","2015-01-15T13:51:43Z",[],[407,408,409,410],"414FB2D4-2283-43FD-BE14E534ECA67928","6C18119B-14BD-4951-B437696F4357BD33","7C692885-DB25-4858-B1FB4FF47B241E9B","D88C0047-EC30-4506-A7DF28A4D765E1CF",[412],"frontiersin_org",[414],"Main_Visual",[416],"Photography",{"x":418,"y":419},2880,1920,[421],"Publishing","One of the world's most cited journals in the fields of oceanography and marine & freshwater biology, investigating ocean systems, biodiversity, ecology and global ocean health.","\u003Cp>Frontiers in Marine Science is an interdisciplinary journal that advances our understanding of marine species, ecosystems, and processes as well as human interactions with, and impacts on, ocean environments.\u003C/p>\n\n\u003Cp>The journal is led by Field Chief Editor Prof Carlos M. Duarte (King Abdullah University of Science and Technology, Saudi Arabia) and indexed in Scopus, Web of Science and DOAJ. It welcomes submissions on all aspects of marine biology and ocean systems, on human activities that exploit or affect oceans and marine life, and the protection and restoration of marine ecosystems. Topics of interest include, but are not limited to:\u003C/p>\n\u003Cul>\n  \u003Cli>coral reef and deep-sea ecology\u003C/li>\n  \u003Cli>global change and the future ocean\u003C/li>\n  \u003Cli>marine affairs and policy\u003C/li>\n  \u003Cli>marine biogeochemistry\u003C/li>\n  \u003Cli>marine biology, biogeography, and biodiversity\u003C/li>\n  \u003Cli>marine biotechnology and bioproducts\u003C/li>\n  \u003Cli>marine conservation and sustainability\u003C/li>\n  \u003Cli>marine fisheries, aquaculture, and living resources\u003C/li>\n  \u003Cli>marine pollution\u003C/li>\n  \u003Cli>physical oceanography\u003C/li>\n  \u003Cli>ocean observation.\u003C/li>\n\u003C/ul>\n\n\u003Cp>Frontiers in Marine Science particularly welcomes new ideas and approaches for ocean-based solutions and which support and advance the UN’s Sustainable Development Goals (SDGs), notably SDG 14: life below water. This includes studies on sustainable blue economies, improved forecasting and observational capacities, understanding biodiversity and ecosystem issues at a local and global level, and effective strategies to manage marine resources and maintain ocean health.\u003C/p>\n\n\u003Cp>Manuscripts that do not directly relate to marine environments, such as those focusing primarily on freshwater or terrestrial ecosystems and non-marine-related engineering and technology studies, are also out of scope. Additionally, research that predominately concerns human health, social sciences, or economics, without a clear link to marine science, will not be considered.\u003C/p>\n\n\u003Cp>Frontiers’ journals require that manuscripts primarily comprising computational studies of public data, must include appropriate validation. Please refer to the \u003Ca href=\"https://www.frontiersin.org/guidelines/policies-and-publication-ethics#standards-for-research-methodology:~:text=complaints%20and%20allegations.-,Standards%20for%20research%20methodology,-Experiments\">Frontiers Standards for research methodology policy\u003C/a>, for more information. Manuscripts not adhering to these standards will not be considered.\u003Cp>\n\n\u003Cp>Frontiers in Marine Science is committed to advancing our understanding and sustainable use of the world’s oceans and their resources by communicating scientific knowledge to researchers and the public alike, to enable the scientific breakthroughs of the future.\u003C/p>","cyan","3.7","5.2","260536","@FrontMarineSci",{"id":124,"name":125,"slug":126,"abbreviation":430,"isOnline":13,"isOpenForSubmissions":13,"impactFactor":431,"citeScore":432},"fmars",3.4,6.5,{"displayTitlePillLabels":13,"displayRelatedArticlesBox":13,"showEditors":13,"showReviewers":13,"showLoopImpactLink":13,"enableFigshare":357},{"isPublic":357,"allowCompanyUsers":357,"whiteListEmails":435,"enableAllJournals":357,"whiteListJournals":436},[],[],{"spaceId":387,"name":387,"availableJournalPages":438,"announcement":442,"useJournalPalettes":357},[264,269,266,439,440,441],"volumes","about","community-reviewers",{"__typename":443,"sys":444,"preHeader":446,"title":447,"description":448,"image":449,"link":523},"Announcement",{"id":445},"30jAeTjZfu9FwrF5jqYs9f","Our quality","Expert judgment makes science stronger","Behind every published article stand expert reviewers safeguarding science. Discover our rigorous approach to peer review.",[450],{"id":451,"src":452,"name":453,"tags":454,"type":380,"width":504,"height":505,"archive":384,"brandId":385,"limited":384,"fileSize":506,"isPublic":387,"original":507,"copyright":28,"extension":508,"thumbnails":509,"dateCreated":517,"description":453,"orientation":402,"watermarked":384,"dateModified":518,"selectedFile":28,"datePublished":519,"streamingLinks":520,"videoPreviewURLs":521,"textMetaproperties":522},"E8101B5E-CD70-402C-B234D8C42CD1D053","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/thumbnail/webimage-Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass","Doctor making notes in hospital, corona virus concept. Shot through glass.",[455,456,457,458,459,460,461,462,463,464,465,466,467,468,469,470,471,472,473,474,475,476,477,478,479,480,481,482,483,484,485,486,487,488,489,490,491,492,493,494,495,496,497,498,499,500,501,502,503],"global","professional","pandemic","conference","contagious","pneumonia","respiratory","medical","glass","exhausted","outbreak","corona","virus","making notes","writing","DOCTOR","contamination","training","Risk","Coronavirus","Science","warning","Hospital","health","close-up","infection","research","safety","prevention","concept","danger","Indoors","Disease","fever","scientist","flu","protection","men","viral","copy space","shot","Clinic","illness","healthcare","cure","seminar","epidemic","treatment","working on",4928,3280,14062390,"https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.jpg",[391],{"mini":510,"thul":511,"original":507,"webimage":452,"Guidelines":512,"WebsiteJpg_XL":513,"WebsiteWebP_L":514,"WebsiteWebP_M":515,"WebsiteWebP_XL":516},"https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/thumbnail/mini-Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/thumbnail/thul-Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/Guidelines/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.png","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/WebsiteJpg_XL/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.jpg","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/WebsiteWebP_L/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.webp","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/WebsiteWebP_M/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.webp","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/WebsiteWebP_XL/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.webp","2022-05-10T11:52:42Z","2026-02-11T15:34:30Z","2022-05-11T12:46:58Z",{},[],[],{"text":524,"url":67,"target":27,"ariaLabel":28},"Learn about peer review",{"loggedUserInfo":-1},{"currentArticle":527,"isPreviewPage":357,"hasSupplementalData":357,"showCrossmarkWidget":13,"articleTemplate":652,"currentArticlePageMetaInfo":653,"xmlParsedArticleContent":773,"xmlParsingError":-1},{"id":528,"doi":529,"title":530,"acceptanceDate":531,"receptionDate":532,"publicationDate":533,"lastModifiedDate":534,"isPublished":13,"abstract":535,"researchTopic":28,"articleType":536,"stage":539,"keywords":541,"authors":547,"editors":584,"reviewers":594,"journal":612,"section":619,"impactMetrics":621,"volume":625,"articleVolume":626,"relatedArticles":627,"isPublishedV2":357,"contents":628,"laySummary":19,"files":629},1398087,"10.3389/fmars.2024.1398087","Droughts and deluges: changes in river discharge and the carbonate chemistry of an urbanized temperate estuary",["Date","2024-06-20T07:18:39.000Z"],["Date","2024-03-08T19:57:19.000Z"],["Date","2024-07-05T00:00:00.000Z"],["Date","2026-10-23T02:12:31.426Z"],"Long Island Sound (LIS) is a highly urbanized estuary that receives high inputs of nitrogen pollution leading to summertime hypoxia in the bottom waters of its western region. Though LIS hypoxia has been well-studied for decades, there is a paucity of information regarding eutrophication-induced acidification due to the challenges of obtaining high-precision observations of the marine carbonate system. In this work, we established a time-series of carbon dioxide (CO2) system observations in LIS through measurements of dissolved inorganic carbon (DIC) and total alkalinity (TA) during thirteen sampling events between March 2020 and August 2022. This time span captured both seasonal and interannual variation, including the contrast between two historic drought years (2020 and 2022) and one high-freshwater flow year with significant tropical storm activity (2021). Observations revealed reduced acidification in western LIS (WLIS) (minimum aragonite saturation state, Ωar > 1.5) during the high-river discharge summer of 2021, corresponding to a decrease in the DIC/TA ratio of the Housatonic River. By contrast, LIS bottom water DIC and DIC/TA were higher during the drought summers of 2020 and 2022 (bottom DIC/TA = 0.9-1.0 and 0.85-0.9 in 2020 and 2021, respectively), leading to more acidified conditions and persistent aragonite undersaturation (minimum Ωar \u003C1.0 and 1.1 in 2020 and 2022, respectively). Increased river discharge mitigated respiration-induced acidification in WLIS, likely due to a combination of decreased estuarine residence time and reduced riverine DIC/TA. These results motivate future studies of the carbonate chemistry of LIS and its freshwater endmembers in relation to hypoxia dynamics, with consideration of climate related shifts in physical and biological dynamics of the estuary with time.",{"id":537,"name":538},24,"Original Research",{"id":540,"name":19},18,[542,543,544,545,546],"Eutrophication","acidification","River chemistry","Estuarine chemistry","hypoxia",[548,558,565,571,578],{"id":549,"firstName":550,"middleName":19,"lastName":551,"givenNames":552,"isCorresponding":13,"isProfilePublic":13,"userId":549,"email":553,"affiliations":554},2677512,"Lauren J.","Barrett","Lauren J. ","lauren.jo.barrett@gmail.com",[555],{"organizationName":556,"countryName":557,"cityName":19,"stateName":19,"zipCode":19},"Department of Marine Sciences, University of Connecticut","United States",{"id":559,"firstName":560,"middleName":19,"lastName":561,"givenNames":562,"isCorresponding":13,"isProfilePublic":13,"userId":559,"email":553,"affiliations":563},160059,"Penny","Vlahos","Penny ",[564],{"organizationName":556,"countryName":557,"cityName":19,"stateName":19,"zipCode":19},{"id":384,"firstName":566,"middleName":19,"lastName":567,"givenNames":568,"isCorresponding":357,"isProfilePublic":357,"userId":384,"email":-1,"affiliations":569},"Mary A.","McGuinness","Mary A. ",[570],{"organizationName":556,"countryName":557,"cityName":19,"stateName":19,"zipCode":19},{"id":572,"firstName":573,"middleName":19,"lastName":574,"givenNames":575,"isCorresponding":357,"isProfilePublic":13,"userId":572,"email":-1,"affiliations":576},1277859,"Michael M.","Whitney","Michael M. ",[577],{"organizationName":556,"countryName":557,"cityName":19,"stateName":19,"zipCode":19},{"id":384,"firstName":579,"middleName":19,"lastName":580,"givenNames":581,"isCorresponding":357,"isProfilePublic":357,"userId":384,"email":-1,"affiliations":582},"Jamie M.P.","Vaudrey","Jamie M.P. ",[583],{"organizationName":556,"countryName":557,"cityName":19,"stateName":19,"zipCode":19},[585],{"id":586,"firstName":587,"middleName":19,"lastName":588,"givenNames":589,"isCorresponding":357,"isProfilePublic":13,"userId":586,"email":-1,"affiliations":590},2358704,"Michele","Giani","Michele ",[591],{"organizationName":592,"countryName":593,"cityName":19,"stateName":19,"zipCode":19},"National Institute of Oceanography and Applied Geophysics (Italy)","Italy",[595,604],{"id":596,"firstName":597,"middleName":19,"lastName":598,"givenNames":599,"isCorresponding":357,"isProfilePublic":13,"userId":596,"email":-1,"affiliations":600},2103009,"Solomon","Dan","Solomon ",[601],{"organizationName":602,"countryName":603,"cityName":19,"stateName":19,"zipCode":19},"Beibu Gulf University","China",{"id":605,"firstName":606,"middleName":19,"lastName":607,"givenNames":608,"isCorresponding":357,"isProfilePublic":13,"userId":605,"email":-1,"affiliations":609},1703355,"CHRISTOPHER","KNIGHTES","CHRISTOPHER ",[610],{"organizationName":611,"countryName":557,"cityName":19,"stateName":19,"zipCode":19},"United States Environmental Protection Agency (EPA)",{"id":124,"slug":126,"name":125,"shortName":613,"electronicISSN":614,"field":615,"specialtyId":28,"journalSectionPaths":617},"Front. Mar. Sci.","2296-7745",{"id":616,"domainId":387},45,[618],{"section":619},{"id":161,"name":162,"slug":163,"specialtyId":620},1508,{"views":622,"downloads":623,"citations":624},5984,1174,2,11,"Volume 11 - 2024",[],{"titleHtml":19,"fullTextHtml":19,"menuHtml":19},[630,635,640,643,648],{"name":631,"fileServerPackageEntryId":19,"fileServerId":632,"fileServerVersionNumber":387,"type":633},"EPUB.epub","1398087/epub",{"code":634,"name":634},"EPUB",{"name":636,"fileServerPackageEntryId":636,"fileServerId":637,"fileServerVersionNumber":387,"type":638},"fmars-11-1398087.pdf","1398087/pubmed-zip",{"code":639,"name":639},"PDF",{"name":636,"fileServerPackageEntryId":19,"fileServerId":641,"fileServerVersionNumber":387,"type":642},"1398087/publishers-proof/pdf",{"code":639,"name":639},{"name":644,"fileServerPackageEntryId":644,"fileServerId":637,"fileServerVersionNumber":387,"type":645},"fmars-11-1398087.xml",{"code":646,"name":647},"NLM_XML","XML",{"name":649,"fileServerPackageEntryId":19,"fileServerId":650,"fileServerVersionNumber":387,"type":651},"Provisional PDF.pdf","1398087/provisional-pdf",{"code":639,"name":639},"v4",{"title":654,"link":655,"meta":659,"script":762},"Frontiers | Droughts and deluges: changes in river discharge and the carbonate chemistry of an urbanized temperate estuary",[656],{"rel":657,"href":658},"canonical","https://www.frontiersin.org/journals/marine-science/articles/10.3389/fmars.2024.1398087/full",[660,663,666,668,671,675,678,682,685,688,691,693,695,697,699,701,704,707,709,712,714,716,719,722,725,728,731,735,739,742,744,747,749,752,754,757,759],{"hid":661,"property":661,"name":661,"content":662},"description","Long Island Sound (LIS) is a highly urbanized estuary that receives high inputs of nitrogen pollution leading to summertime hypoxia in the bottom waters of i...",{"hid":664,"property":664,"name":665,"content":654},"og:title","title",{"hid":667,"property":667,"name":661,"content":662},"og:description",{"hid":669,"name":669,"content":670},"keywords","Eutrophication,acidification,River chemistry,Estuarine chemistry,hypoxia",{"hid":672,"property":672,"name":673,"content":674},"og:site_name","site_name","Frontiers",{"hid":676,"property":676,"name":380,"content":677},"og:image","https://www.frontiersin.org/api/ipx/w=1200&f=png/https://www.frontiersin.org/files/Articles/1398087/fmars-11-1398087-HTML/image_m/fmars-11-1398087-g001.jpg",{"hid":679,"property":679,"name":680,"content":681},"og:type","type","article",{"hid":683,"property":683,"name":684,"content":658},"og:url","url",{"hid":686,"name":686,"content":687},"twitter:card","summary_large_image",{"hid":689,"name":689,"content":690},"citation_volume","11",{"hid":692,"name":692,"content":125},"citation_journal_title",{"hid":694,"name":694,"content":674},"citation_publisher",{"hid":696,"name":696,"content":613},"citation_journal_abbrev",{"hid":698,"name":698,"content":614},"citation_issn",{"hid":700,"name":700,"content":529},"citation_doi",{"hid":702,"name":702,"content":703},"citation_firstpage","1398087",{"hid":705,"name":705,"content":706},"citation_language","English",{"hid":708,"name":708,"content":530},"citation_title",{"hid":710,"name":710,"content":711},"citation_keywords","Eutrophication; acidification; River chemistry; Estuarine chemistry; hypoxia",{"hid":713,"name":713,"content":535},"citation_abstract",{"hid":715,"name":715,"content":538},"citation_article_type",{"hid":717,"name":717,"content":718},"citation_pdf_url","https://www.frontiersin.org/journals/marine-science/articles/10.3389/fmars.2024.1398087/pdf",{"hid":720,"name":720,"content":721},"citation_xml_url","https://www.frontiersin.org/journals/marine-science/articles/10.3389/fmars.2024.1398087/xml",{"hid":723,"name":723,"content":724},"citation_fulltext_world_readable","yes",{"hid":726,"name":726,"content":727},"citation_online_date","2024/06/20",{"hid":729,"name":729,"content":730},"citation_publication_date","2024/07/05",{"hid":732,"name":733,"content":734},"citation_author_0","citation_author","Barrett, Lauren J. ",{"hid":736,"name":737,"content":738},"citation_author_institution_0","citation_author_institution","Department of Marine Sciences, University of Connecticut, United States",{"hid":740,"name":733,"content":741},"citation_author_1","Vlahos, Penny ",{"hid":743,"name":737,"content":738},"citation_author_institution_1",{"hid":745,"name":733,"content":746},"citation_author_2","McGuinness, Mary A. ",{"hid":748,"name":737,"content":738},"citation_author_institution_2",{"hid":750,"name":733,"content":751},"citation_author_3","Whitney, Michael M. ",{"hid":753,"name":737,"content":738},"citation_author_institution_3",{"hid":755,"name":733,"content":756},"citation_author_4","Vaudrey, Jamie M.P. ",{"hid":758,"name":737,"content":738},"citation_author_institution_4",{"hid":760,"name":760,"content":761},"dc.identifier","doi:10.3389/fmars.2024.1398087",[763,766,769,771],{"src":764,"body":13,"type":765,"async":13},"https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?features=es6","text/javascript",{"innerHTML":767,"type":768},"MathJax.Hub.Config({\"CommonHTML\":{linebreaks:{automatic:true,width:\"container\"}}});","text/x-mathjax-config",{"src":770,"body":13,"type":765,"async":13},"https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.1/MathJax.js?config=TeX-MML-AM_CHTML",{"src":772,"body":13,"type":765,"async":13},"https://crossmark-cdn.crossref.org/widget/v2.0/widget.js",{"journal":774,"doi":529,"articleType":538,"title":776,"authors":778,"onBehalfOf":19,"affiliations":793,"authorNotes":797,"publicationDate":831,"acceptedDate":832,"receivedDate":833,"correctedDate":19,"retractedDate":19,"volume":625,"elocationId":528,"permissions":834,"keywords":854,"relatedArticles":868,"abstractContent":869,"bodyContent":894,"appendixContent":3145,"statements":3146,"referenceLists":3250,"references":8494,"otherBackSections":13157,"figures":13158,"toc":13601,"correspondingAuthors":13613},{"title":125,"abbreviation":613,"issn":614,"publisherName":775},"Frontiers Media S.A.",[777],{"#text":530},[779,783,786,788,791],{"surname":551,"givenNames":550,"suffix":19,"affiliationsIndexes":780,"isCorresponding":357,"equalContrib":357,"hierarchySymbol":781,"footnoteSymbol":19,"loopUrl":782,"onBehalfOf":19},[],"\n            *\n          ","https://loop.frontiersin.org/people/2677512",{"surname":561,"givenNames":560,"suffix":19,"affiliationsIndexes":784,"isCorresponding":357,"equalContrib":357,"hierarchySymbol":781,"footnoteSymbol":19,"loopUrl":785,"onBehalfOf":19},[],"https://loop.frontiersin.org/people/160059",{"surname":567,"givenNames":566,"suffix":19,"affiliationsIndexes":787,"isCorresponding":357,"equalContrib":357,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":19,"onBehalfOf":19},[],{"surname":574,"givenNames":573,"suffix":19,"affiliationsIndexes":789,"isCorresponding":357,"equalContrib":357,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":790,"onBehalfOf":19},[],"https://loop.frontiersin.org/people/1277859",{"surname":580,"givenNames":579,"suffix":19,"affiliationsIndexes":792,"isCorresponding":357,"equalContrib":357,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":19,"onBehalfOf":19},[],[794],{"index":384,"baseText":19,"institution":556,"country":557,"address":795,"textContent":796},"Groton, CT","Department of Marine Sciences, University of Connecticut, Groton, CT, United States",{"editedBy":798,"editedByContent":801,"reviewedBy":810,"reviewedByContent":815,"approvedBy":826,"approvedByContent":827,"correspondence":828,"equalContribution":829,"presentAddress":19,"other":830},[799],{"textContent":800},"Edited by: Michele Giani, National Institute of Oceanography and Applied Geophysics, Italy",[802,804,808],{"#text":803},"\n          ",{"p":805},[806],{"#text":807}," Michele Giani, National Institute of Oceanography and Applied Geophysics, Italy",{"#text":809},"\n        ",[811,813],{"textContent":812},"Reviewed by: Solomon Dan, Beibu Gulf University, China",{"textContent":814},"Christopher Knightes, United States Environmental Protection Agency (EPA), United States",[816,817,821,822,825],{"#text":803},{"p":818},[819],{"#text":820}," Solomon Dan, Beibu Gulf University, China",{"#text":803},{"p":823},[824],{"#text":814},{"#text":809},[],[],"\n          *Correspondence: Lauren J. Barrett, bGF1cmVuLmpvLmJhcnJldHRAZ21haWwuY29t; Penny Vlahos, cGVubnkudmxhaG9zQHVjb25uLmVkdQ==\n        ",[],[],"2024-07-05","2024-06-20","2024-03-08",{"copyrightStatement":835,"copyrightYear":836,"copyrightHolder":837,"licenseUrl":838,"licenseText":839},"Copyright © 2024 Barrett, Vlahos, McGuinness, Whitney and Vaudrey",2024,"Barrett, Vlahos, McGuinness, Whitney and Vaudrey","http://creativecommons.org/licenses/by/4.0/",[840,841,853],{"#text":803},{"p":842},[843,845,851],{"#text":844},"This is an open-access article distributed under the terms of the ",{"ext-link":846,":@":849},[847],{"#text":848},"Creative Commons Attribution License (CC BY)",{"@_ext-link-type":850,"@_xlink:href":838},"uri",{"#text":852},". The use, distribution or reproduction in other forums is permitted, provided the original author(s) and the copyright owner(s) are credited and that the original publication in this journal is cited, in accordance with accepted academic practice. No use, distribution or reproduction is permitted which does not comply with these terms.",{"#text":809},[855,858,860,863,866],[856],{"#text":857},"eutrophication",[859],{"#text":543},[861],{"#text":862},"river chemistry",[864],{"#text":865},"estuarine chemistry",[867],{"#text":546},[],[870,871,892],{"#text":809},{"p":872},[873,875,879,881,885,887,890],{"#text":874},"Long Island Sound (LIS) is a highly urbanized estuary that receives high inputs of nitrogen pollution leading to summertime hypoxia in the bottom waters of its western region. Though LIS hypoxia has been well-studied for decades, there is a paucity of information regarding eutrophication-induced acidification due to the challenges of obtaining high-precision observations of the marine carbonate system. In this work, we established a time-series of carbon dioxide (CO",{"sub":876},[877],{"#text":878},"2",{"#text":880},") system observations in LIS through measurements of dissolved inorganic carbon (DIC) and total alkalinity (TA) during thirteen sampling events between March 2020 and August 2022. This time span captured both seasonal and interannual variation, including the contrast between two historic drought years (2020 and 2022) and one high-freshwater flow year with significant tropical storm activity (2021). Observations revealed reduced acidification in western LIS (WLIS) (minimum aragonite saturation state, Ω",{"sub":882},[883],{"#text":884},"ar",{"#text":886}," > 1.5) during the high-river discharge summer of 2021, corresponding to a decrease in the DIC/TA ratio of the Housatonic River. By contrast, LIS bottom water DIC and DIC/TA were higher during the drought summers of 2020 and 2022 (bottom DIC/TA = 0.9-1.0 and 0.85-0.9 in 2020 and 2021, respectively), leading to more acidified conditions and persistent aragonite undersaturation (minimum Ω",{"sub":888},[889],{"#text":884},{"#text":891}," \u003C1.0 and 1.1 in 2020 and 2022, respectively). Increased river discharge mitigated respiration-induced acidification in WLIS, likely due to a combination of decreased estuarine residence time and reduced riverine DIC/TA. These results motivate future studies of the carbonate chemistry of LIS and its freshwater endmembers in relation to hypoxia dynamics, with consideration of climate related shifts in physical and biological dynamics of the estuary with time.",{"#text":893},"\n      ",[895,897,1123,1124,1478,1479,2607,2608,3109,3110,3126,3127,3143],{"#text":896},"\n    ",{"sec":898,":@":1120,"anchorId":1121},[899,901,905,906,1008,1009,1067,1068,1114,1115,1119],{"#text":900},"\n      \n      ",{"title":902},[903],{"#text":904},"1 Introduction",{"#text":893},{"p":907},[908,910,913,915,922,924,930,932,938,940,946,948,951,953,959,960,966,967,973,975,979,981,984,986,992,993,999,1000,1006],{"#text":909},"The global ocean has absorbed ~25% of anthropogenic carbon dioxide (CO",{"sub":911},[912],{"#text":878},{"#text":914},") emissions over the past ~200 years (",{"xref":916,":@":919},[917],{"#text":918},"Friedlingstein et al., 2022",{"@_ref-type":920,"@_rid":921},"bibr","B18",{"#text":923},"), leading to a long-term decrease in marine pH, or “ocean acidification” (",{"xref":925,":@":928},[926],{"#text":927},"Doney et al., 2009",{"@_ref-type":920,"@_rid":929},"B11",{"#text":931},"). While this problem is observable and well-documented in the open ocean (",{"xref":933,":@":936},[934],{"#text":935},"Feely et al., 2009",{"@_ref-type":920,"@_rid":937},"B17",{"#text":939},"; ",{"xref":941,":@":944},[942],{"#text":943},"Orr, 2011",{"@_ref-type":920,"@_rid":945},"B35",{"#text":947},"), in coastal systems there are additional processes that can either exacerbate or relieve acidification resulting from atmospheric CO",{"sub":949},[950],{"#text":878},{"#text":952}," (",{"xref":954,":@":957},[955],{"#text":956},"Cai et al., 2011",{"@_ref-type":920,"@_rid":958},"B3",{"#text":939},{"xref":961,":@":964},[962],{"#text":963},"Duarte et al., 2013",{"@_ref-type":920,"@_rid":965},"B12",{"#text":939},{"xref":968,":@":971},[969],{"#text":970},"Wallace et al., 2014",{"@_ref-type":920,"@_rid":972},"B49",{"#text":974},"). In many estuaries with substantial anthropogenic influence, nutrient pollution stimulating algal growth and microbial respiration leads to the co-occurrence of low-oxygen conditions (hypoxia, dissolved oxygen concentration \u003C 3 mg L",{"sup":976},[977],{"#text":978},"-1",{"#text":980}," or 94 μmol L",{"sup":982},[983],{"#text":978},{"#text":985},") and enhanced acidification (",{"xref":987,":@":990},[988],{"#text":989},"Laurent et al., 2017",{"@_ref-type":920,"@_rid":991},"B25",{"#text":939},{"xref":994,":@":997},[995],{"#text":996},"Brodeur et al., 2019",{"@_ref-type":920,"@_rid":998},"B2",{"#text":939},{"xref":1001,":@":1004},[1002],{"#text":1003},"Xiong et al., 2020",{"@_ref-type":920,"@_rid":1005},"B54",{"#text":1007},").",{"#text":893},{"p":1010},[1011,1013,1019,1020,1026,1028,1034,1036,1042,1043,1049,1051,1057,1059,1065],{"#text":1012},"The temperate estuary Long Island Sound (LIS) borders the New York City metropolitan area, the Connecticut coast, and Long Island’s north shore. Nitrogen enters LIS from point sources such as wastewater discharge and from nonpoint sources such as atmospheric deposition and fertilizer use. Nitrogen pollution leads to surface water eutrophication in LIS, stimulating intense spring and summertime primary productivity (",{"xref":1014,":@":1017},[1015],{"#text":1016},"Goebel et al., 2006",{"@_ref-type":920,"@_rid":1018},"B22",{"#text":939},{"xref":1021,":@":1024},[1022],{"#text":1023},"Vaudrey, 2017",{"@_ref-type":920,"@_rid":1025},"B46",{"#text":1027},"). As the water column becomes density stratified in the summer and phytoplankton biomass sinks, microbial respiration depletes oxygen in bottom waters (",{"xref":1029,":@":1032},[1030],{"#text":1031},"Anderson and Taylor, 2001",{"@_ref-type":920,"@_rid":1033},"B1",{"#text":1035},"). As a result, hypoxic conditions of varying extent and duration have consistently been observed in the bottom waters of Long Island Sound during the summertime since the late 1980’s (",{"xref":1037,":@":1040},[1038],{"#text":1039},"Wilson et al., 2008",{"@_ref-type":920,"@_rid":1041},"B53",{"#text":939},{"xref":1044,":@":1047},[1045],{"#text":1046},"Duvall et al., 2023",{"@_ref-type":920,"@_rid":1048},"B13",{"#text":1050},"). Implementation of nitrogen total maximum daily loads (TMDL) in 2000 (",{"xref":1052,":@":1055},[1053],{"#text":1054},"NY DEC and CT DEEP, 2000",{"@_ref-type":920,"@_rid":1056},"B32",{"#text":1058},") included substantial efforts to upgrade wastewater treatment systems. The primary goal of reducing nitrogen input to LIS by 58.5% relative to pre-TMDL values was achieved in 2016. The reduction of nitrogen pollution to LIS has led to a marked decrease in hypoxic area of up to 60% of the pre-TMDL value (",{"xref":1060,":@":1063},[1061],{"#text":1062},"Long Island Sound Study, 2022",{"@_ref-type":920,"@_rid":1064},"B27",{"#text":1066},"). However, hypoxia remains a persistent issue in LIS and is regularly monitored by the Connecticut Department of Energy and Environmental Protection (CT DEEP) and the Environmental Protection Agency (EPA) Long Island Sound Study (LISS).",{"#text":893},{"p":1069},[1070,1072,1076,1078,1084,1086,1092,1094,1097,1099,1105,1107,1113],{"#text":1071},"Though acidification co-occurs with hypoxia in LIS (",{"xref":1073,":@":1075},[1074],{"#text":970},{"@_ref-type":920,"@_rid":972},{"#text":1077},"), inorganic carbon dynamics have received much less attention than dissolved oxygen. This is despite the knowledge that estuarine acidification imposes ecological and economic concerns (",{"xref":1079,":@":1082},[1080],{"#text":1081},"Ekstrom et al., 2015",{"@_ref-type":920,"@_rid":1083},"B14",{"#text":1085},") and contributes to a multi-stressor environment for marine organisms (",{"xref":1087,":@":1090},[1088],{"#text":1089},"Gobler and Baumann, 2016",{"@_ref-type":920,"@_rid":1091},"B21",{"#text":1093},"). The paucity of carbonate system information in LIS is in part due to the historical practical and financial barriers to obtaining high-quality data. Potentiometric pH measurements were added to monthly routine monitoring of LIS by CT DEEP in 2011. However, pH alone is not sufficient to define the ocean carbonate system, which has two degrees of freedom, meaning two of four measurable parameters (total alkalinity, dissolved inorganic carbon, pH, and partial pressure of CO",{"sub":1095},[1096],{"#text":878},{"#text":1098},") are required to compute all variables in the system (",{"xref":1100,":@":1103},[1101],{"#text":1102},"Dickson et al., 2007",{"@_ref-type":920,"@_rid":1104},"B10",{"#text":1106},"). Additionally, potentiometric pH observations, though more accessible than high-precision measurements, are subject to large uncertainties (",{"xref":1108,":@":1111},[1109],{"#text":1110},"McLaughlin et al., 2017",{"@_ref-type":920,"@_rid":1112},"B31",{"#text":1007},{"#text":893},{"p":1116},[1117],{"#text":1118},"In this study, we established a time-series of carbonate system observations in LIS in collaboration with routine water quality monitoring by CT DEEP and LISS. We aimed to address the knowledge gap of baseline carbonate chemistry characteristics to achieve a more complete understanding of LIS biogeochemical cycles, the degree of aragonite undersaturation during seasonal hypoxia, and the confounding stressors to the LIS ecosystem. With these insights we can improve our predictions of how LIS and other temperate estuaries may be impacted by anticipated climate changes to inform strategies for sustainable ecosystem management. Carbonate chemistry trends were evaluated in relation to hydrodynamics and other seasonal influences via endmember sampling and comprehensive seasonal and interannual surveys. Surface and bottom water total alkalinity (TA), dissolved inorganic carbon (DIC), and hydrographic data were collected across the estuary during thirteen sampling events between March 2020 and August 2022, capturing seasonal and interannual variations and refining the understanding of the relationship between acidification and hypoxia in LIS. This information is placed in context with similar northwestern Atlantic estuaries to examine the ways in which LIS does and does not align with biogeochemical dynamics in other regions.",{"#text":896},{"@_id":1121,"@_sec-type":1122},"s1","intro",{"#text":896},{"sec":1125,":@":1476,"anchorId":1477},[1126,1127,1131,1132,1244,1245,1327,1328,1373,1374,1475],{"#text":900},{"title":1128},[1129],{"#text":1130},"2 Methods",{"#text":893},{"sec":1133,":@":1242},[1134,1136,1140,1141,1198,1199,1225,1226,1241],{"#text":1135},"\n        \n        ",{"title":1137},[1138],{"#text":1139},"2.1 Study area and sampling approach",{"#text":809},{"p":1142},[1143,1145,1154,1156,1162,1163,1169,1171,1177,1179,1183,1185,1191,1193,1197],{"#text":1144},"LIS is an urbanized, seasonally eutrophic estuary on the east coast of the United States (",{"xref":1146,":@":1151},[1147],{"bold":1148},[1149],{"#text":1150},"Figure 1",{"@_ref-type":1152,"@_rid":1153},"fig","f1",{"#text":1155},"). The macrotidal estuary is bordered by Connecticut to the north, by Long Island, NY to the south, and by New York City to the west. Most of the seawater exchange occurs through the mouth of the estuary in eastern LIS (ELIS) where it is connected to the Mid Atlantic Bight (",{"xref":1157,":@":1160},[1158],{"#text":1159},"O’Donnell et al., 2014",{"@_ref-type":920,"@_rid":1161},"B34",{"#text":939},{"xref":1164,":@":1167},[1165],{"#text":1166},"Whitney et al., 2016",{"@_ref-type":920,"@_rid":1168},"B51",{"#text":1170},"). A much smaller exchange also occurs in WLIS where the head of the estuary is connected to the East River, a tidal strait connected to the Hudson River estuary (",{"xref":1172,":@":1175},[1173],{"#text":1174},"Gay et al., 2004",{"@_ref-type":920,"@_rid":1176},"B20",{"#text":1178},"). The Connecticut River is the largest freshwater source, accounting for 75% of annual freshwater delivery, and enters near the estuary mouth. The next largest freshwater source is the Housatonic River in western LIS, accounting for 10% of annual river discharge to the estuary (",{"xref":1180,":@":1182},[1181],{"#text":1174},{"@_ref-type":920,"@_rid":1176},{"#text":1184},"). Due to the circulation patterns in LIS, the Connecticut River comprises >50% and >70% of the freshwater in western and eastern LIS, respectively, while the Housatonic River comprises >25% and >10% of the freshwater in western and eastern LIS, respectively (",{"xref":1186,":@":1189},[1187],{"#text":1188},"Deignan-Schmidt and Whitney, 2018",{"@_ref-type":920,"@_rid":1190},"B5",{"#text":1192},"). The residence time of freshwater in LIS ranges from 3-6 months, depending on river discharge (",{"xref":1194,":@":1196},[1195],{"#text":1188},{"@_ref-type":920,"@_rid":1190},{"#text":1007},{"#text":809},{"fig":1200,":@":1223},[1201,1202,1205,1206,1215,1216,1222],{"#text":803},{"label":1203},[1204],{"#text":1150},{"#text":803},{"caption":1207},[1208,1210,1214],{"#text":1209},"\n            ",{"p":1211},[1212],{"#text":1213},"Location of Long Island Sound on the USA east coast and locations of surface and bottom water sample collection for the thirteen sampling events in this study. Station labels are consistent with those utilized by CT DEEP and LISS over thirty years of monitoring.",{"#text":803},{"#text":803},{"graphic":1217,":@":1218},[],{"@_mimetype":380,"@_mime-subtype":1219,"@_xmlns:xlink":1220,"@_xlink:href":1221},"tiff","http://www.w3.org/1999/xlink","fmars-11-1398087-g001.tif",{"#text":809},{"@_id":1153,"@_position":1224},"float",{"#text":809},{"p":1227},[1228,1230,1239],{"#text":1229},"Carbonate system, nutrient, and hydrographic parameters were observed at ten stations across thirteen sampling events between March 2020 and August 2022 aboard the R/V John Dempsey (",{"xref":1231,":@":1236},[1232],{"bold":1233},[1234],{"#text":1235},"Supplementary Table S1",{"@_ref-type":1237,"@_rid":1238},"supplementary-material","SM1",{"#text":1240},"). Each sampling event spanned at least three days, with one day each dedicated to the eastern, western, and central Sound, normally in that order. The sampling frequency is always greatest in the summer (typically biweekly) to allow CT DEEP to better assess patterns of hypoxia, with monthly sampling occurring year-round. Thus, a full seasonal comparison between spring, summer, and autumn was captured for 2020 and 2021.",{"#text":893},{"@_id":1243},"s2_1",{"#text":893},{"sec":1246,":@":1325},[1247,1248,1252,1253,1324],{"#text":1135},{"title":1249},[1250],{"#text":1251},"2.2 Discrete water column samples",{"#text":809},{"p":1254},[1255,1257,1263,1265,1271,1273,1276,1278,1284,1286,1289,1291,1297,1299,1302,1304,1307,1309,1315,1317,1323],{"#text":1256},"Discrete samples for TA and DIC were collected at each station in ",{"xref":1258,":@":1262},[1259],{"bold":1260},[1261],{"#text":1150},{"@_ref-type":1152,"@_rid":1153},{"#text":1264}," for both surface (2 m depth) and deep waters (~2 m above bottom). DIC samples were collected in triplicate from 10L Niskin bottles into 20 mL borosilicate vials with polytetrafluoroethylene (PTFE) and aluminum crimp tops and preserved with 10μL saturated mercuric chloride to a final concentration of 0.05% (v/v). DIC was measured using a Shimadzu TOC-L analyzer (",{"xref":1266,":@":1269},[1267],{"#text":1268},"USGS, 2019",{"@_ref-type":920,"@_rid":1270},"B42",{"#text":1272},") calibrated using CO",{"sub":1274},[1275],{"#text":878},{"#text":1277}," certified reference materials (CRMs) (",{"xref":1279,":@":1282},[1280],{"#text":1281},"Dickson et al., 2003",{"@_ref-type":920,"@_rid":1283},"B8",{"#text":1285},") with an average precision of 4.76 μmol kg",{"sup":1287},[1288],{"#text":978},{"#text":1290}," (\u003C 0.3%). TA samples were collected in 250 mL high density polyethylene (HDPE) bottles and preserved with 100 μL of saturated mercuric chloride. TA was analyzed using a Contros HYDROFIA TA Analyzer (",{"xref":1292,":@":1295},[1293],{"#text":1294},"Seelmann et al., 2019",{"@_ref-type":920,"@_rid":1296},"B39",{"#text":1298},") calibrated with CO",{"sub":1300},[1301],{"#text":878},{"#text":1303}," CRMs with an average precision of 2.5 μmol kg",{"sup":1305},[1306],{"#text":978},{"#text":1308}," (\u003C 0.2%). Orthophosphate and silicate samples were collected and analyzed by CT DEEP following EPA methods 365.1 and 370.1, respectively (",{"xref":1310,":@":1313},[1311],{"#text":1312},"EPA, 1978",{"@_ref-type":920,"@_rid":1314},"B16",{"#text":1316},", ",{"xref":1318,":@":1321},[1319],{"#text":1320},"1993",{"@_ref-type":920,"@_rid":1322},"B15",{"#text":1007},{"#text":893},{"@_id":1326},"s2_2",{"#text":893},{"sec":1329,":@":1371},[1330,1331,1335,1336,1370],{"#text":1135},{"title":1332},[1333],{"#text":1334},"2.3 Continuous surface water observations",{"#text":809},{"p":1337},[1338,1340,1343,1345,1348,1350,1353,1355,1358,1360,1363,1365,1368],{"#text":1339},"Temperature (± 0.01°C), salinity (practical salinity scale, ± 0.1), dissolved oxygen (DO) (± 3.1 μmol kg",{"sup":1341},[1342],{"#text":978},{"#text":1344},"), pH (NBS scale, ± 0.1), and partial pressure of CO",{"sub":1346},[1347],{"#text":878},{"#text":1349}," (pCO",{"sub":1351},[1352],{"#text":878},{"#text":1354},") (± 2-5 ppm) were measured across LIS surface waters. These parameters were measured continuously in seawater pumped onto the ship from a ~2-m depth intake. Temperature, salinity, and pH were measured once per minute using a YSI Exo2 multiparameter sonde. A three-point pH calibration (4.01, 7.00, and 10.01, all ± 0.01) and one-point salinity calibration (50 mS cm",{"sup":1356},[1357],{"#text":978},{"#text":1359}," conductivity, Ricca) were performed at 25°C before each cruise. pCO",{"sub":1361},[1362],{"#text":878},{"#text":1364}," was measured once per second in the flow-through surface water using a Turner C-Sense pCO",{"sub":1366},[1367],{"#text":878},{"#text":1369}," probe and then averaged across 5-minute intervals. The probe was calibrated annually by the manufacturer and displayed no drift over the study period.",{"#text":893},{"@_id":1372},"s2_3",{"#text":893},{"sec":1375,":@":1473},[1376,1377,1381,1382,1445,1446,1472],{"#text":1135},{"title":1378},[1379],{"#text":1380},"2.4 Computations",{"#text":809},{"p":1383},[1384,1386,1392,1394,1400,1401,1407,1408,1414,1416,1422,1424,1430,1432,1438,1440,1443],{"#text":1385},"Carbonate system computations including error propagations were carried out in Python using the PyCO2SYS package (",{"xref":1387,":@":1390},[1388],{"#text":1389},"Humphreys et al., 2022",{"@_ref-type":920,"@_rid":1391},"B23",{"#text":1393},") with inputs of TA and DIC along with salinity, temperature, and pressure. The empirical constants used were those of ",{"xref":1395,":@":1398},[1396],{"#text":1397},"Lueker et al. (2000)",{"@_ref-type":920,"@_rid":1399},"B28",{"#text":1316},{"xref":1402,":@":1405},[1403],{"#text":1404},"Dickson (1990)",{"@_ref-type":920,"@_rid":1406},"B7",{"#text":1316},{"xref":1409,":@":1412},[1410],{"#text":1411},"Dickson and Riley (1979)",{"@_ref-type":920,"@_rid":1413},"B9",{"#text":1415},", and ",{"xref":1417,":@":1420},[1418],{"#text":1419},"Lee et al. (2010)",{"@_ref-type":920,"@_rid":1421},"B26",{"#text":1423},". For all cruises labelled “WQ” (water quality, ",{"xref":1425,":@":1429},[1426],{"bold":1427},[1428],{"#text":1235},{"@_ref-type":1237,"@_rid":1238},{"#text":1431},"), nutrient data were available from CT DEEP and phosphate and silicate were included in calculations. However, nutrient observations were not available for “HY” (hypoxia, ",{"xref":1433,":@":1437},[1434],{"bold":1435},[1436],{"#text":1235},{"@_ref-type":1237,"@_rid":1238},{"#text":1439},") cruises, so concentrations were assumed to be 0. This assumption was made based on high rates of surface nutrient uptake in the summer, as well as the relatively low error associated with omitting the alkalinity contribution from nutrients (0.5 to 1.5 μmol kg",{"sup":1441},[1442],{"#text":978},{"#text":1444},"), which was propagated into the calculations of the carbonate system.",{"#text":809},{"p":1447},[1448,1450,1456,1458,1462,1464,1470],{"#text":1449},"Apparent oxygen utilization (AOU) was calculated in Python using the Gibbs Seawater package (",{"xref":1451,":@":1454},[1452],{"#text":1453},"McDougall and Barker, 2011",{"@_ref-type":920,"@_rid":1455},"B29",{"#text":1457},"). ",{"italic":1459},[1460],{"#text":1461},"In-situ",{"#text":1463}," salinity, temperature, and depth data were used to calculate potential temperature, from which the oxygen solubility was calculated via the equations of ",{"xref":1465,":@":1468},[1466],{"#text":1467},"Garcia and Gordon (1993)",{"@_ref-type":920,"@_rid":1469},"B19",{"#text":1471},".",{"#text":893},{"@_id":1474},"s2_4",{"#text":896},{"@_id":1477},"s2",{"#text":896},{"sec":1480,":@":2604,"anchorId":2605},[1481,1482,1486,1487,1613,1614,2068,2069,2603],{"#text":900},{"title":1483},[1484],{"#text":1485},"3 Results",{"#text":893},{"sec":1488,":@":1611},[1489,1490,1494,1495,1523,1524,1586,1587,1610],{"#text":1135},{"title":1491},[1492],{"#text":1493},"3.1 Precipitation and river discharge",{"#text":809},{"p":1496},[1497,1499,1507,1509,1513,1515,1522],{"#text":1498},"The precipitation conditions in Connecticut, and more broadly the northeast US, are highly relevant to the hydrological dynamics of LIS, as > 85% of freshwater input to the estuary occurs from rivers traversing the state. ",{"xref":1500,":@":1505},[1501],{"bold":1502},[1503],{"#text":1504},"Figure 2",{"@_ref-type":1152,"@_rid":1506},"f2",{"#text":1508}," shows the 2020 – 2022 monthly average discharge of the two major tributaries to LIS, the Housatonic River in the center/west (accounting for 10% of total freshwater input to LIS), and the Connecticut River in the east (accounting for 75% of total freshwater input to LIS, ",{"xref":1510,":@":1512},[1511],{"#text":1174},{"@_ref-type":920,"@_rid":1176},{"#text":1514},"). The monthly river discharge climatology shows that in summer 2021, the discharge of both rivers exceeded that of 2020 and 2022 by 3-4 times. This was reflected in the salinity of WLIS, as summertime (August) salinity was ~1 unit lower in 2021 than in 2020 and 2022 (",{"xref":1516,":@":1521},[1517],{"bold":1518},[1519],{"#text":1520},"Supplementary Figure 1",{"@_ref-type":1237,"@_rid":1238},{"#text":1007},{"#text":809},{"fig":1525,":@":1585},[1526,1527,1530,1531,1579,1580,1584],{"#text":803},{"label":1528},[1529],{"#text":1504},{"#text":803},{"caption":1532},[1533,1534,1578],{"#text":1209},{"p":1535},[1536,1538,1542,1544,1548,1550,1554,1556,1562,1564,1568,1570,1576],{"#text":1537},"Monthly-averaged discharge for the ",{"bold":1539},[1540],{"#text":1541},"(A)",{"#text":1543}," Housatonic and ",{"bold":1545},[1546],{"#text":1547},"(B)",{"#text":1549}," Connecticut Rivers. The Housatonic River discharges into WLIS in Bridgeport, CT, and accounts for ~10% of freshwater input to LIS (",{"xref":1551,":@":1553},[1552],{"#text":1174},{"@_ref-type":920,"@_rid":1176},{"#text":1555},"). Discharge data shown here are from Stevenson, CT, 30 km inland (",{"xref":1557,":@":1560},[1558],{"#text":1559},"USGS, 2022a",{"@_ref-type":920,"@_rid":1561},"B44",{"#text":1563},"). The Connecticut River discharges into ELIS in Old Lyme, CT, and accounts for ~75% of freshwater input to LIS (",{"xref":1565,":@":1567},[1566],{"#text":1174},{"@_ref-type":920,"@_rid":1176},{"#text":1569},"). Discharge data shown here are from Thompsonville, CT, 100 km inland (",{"xref":1571,":@":1574},[1572],{"#text":1573},"USGS, 2022b",{"@_ref-type":920,"@_rid":1575},"B45",{"#text":1577},"). Note the different y-axis scales for the two subplots.",{"#text":803},{"#text":803},{"graphic":1581,":@":1582},[],{"@_mimetype":380,"@_mime-subtype":1219,"@_xlink:href":1583},"fmars-11-1398087-g002.tif",{"#text":809},{"@_id":1506,"@_position":1224},{"#text":809},{"p":1588},[1589,1591,1597,1599,1603,1605,1609],{"#text":1590},"This study captured the contrast between two historic drought seasons (summer and fall of 2020 and 2022) and one high-precipitation season (summer 2021). In August and September 2020, up to 60% of the state of Connecticut experienced a standardized precipitation index (SPI) \u003C -1.6, indicating extreme drought conditions relative to the climatological mean for the region (",{"xref":1592,":@":1595},[1593],{"#text":1594},"NIDIS, 2023",{"@_ref-type":920,"@_rid":1596},"B33",{"#text":1598},"). SPI remained \u003C -0.5 for much of the state from July 2020 through April 2021. During May 2021 – February 2022, exceptionally wet conditions prevailed, with ~40% of Connecticut experiencing an SPI > 2 (",{"xref":1600,":@":1602},[1601],{"#text":1594},{"@_ref-type":920,"@_rid":1596},{"#text":1604},"). Four tropical storm systems made landfall in Connecticut between July and September of 2021 (Elsa, Fred, Henri, and Ida), accounting for much of the excess rainfall. The wet conditions of 2021 were followed by an even more extreme drought in 2022, where from April to August 60% of the state had an SPI \u003C -1.6, and 20% \u003C -2.0 (",{"xref":1606,":@":1608},[1607],{"#text":1594},{"@_ref-type":920,"@_rid":1596},{"#text":1007},{"#text":893},{"@_id":1612},"s3_1",{"#text":893},{"sec":1615,":@":2066},[1616,1617,1621,1622,1681,1682,1736,1737,1793,1794,1870,1871,1958,1959,2016,2017,2065],{"#text":1135},{"title":1618},[1619],{"#text":1620},"3.2 Water column carbonate chemistry",{"#text":809},{"p":1623},[1624,1626,1633,1635,1639,1641,1644,1646,1654,1656,1659,1661,1664,1666,1669,1671,1674,1676,1679],{"#text":1625},"For all sampling events, TA was generally highest in ELIS at the estuary mouth and decreased westward to the estuary head (",{"xref":1627,":@":1632},[1628],{"bold":1629},[1630],{"#text":1631},"Supplementary Figure 2",{"@_ref-type":1237,"@_rid":1238},{"#text":1634},"), consistent with salinity trends (p \u003C 10",{"sup":1636},[1637],{"#text":1638},"-35",{"#text":1640},", R",{"sup":1642},[1643],{"#text":878},{"#text":1645}," = 0.59, n = 178, ",{"xref":1647,":@":1652},[1648],{"bold":1649},[1650],{"#text":1651},"Figure 3A",{"@_ref-type":1152,"@_rid":1653},"f3",{"#text":1655},") and seawater exchange. Throughout the study period, surface and bottom water TA ranged from 1862 – 2113 and 1840 – 2133 μmol kg",{"sup":1657},[1658],{"#text":978},{"#text":1660},", respectively. For all three sampling years, the highest TA values tended to occur in the fall (late August – October). Summer and autumn TA values were lower in 2021 as compared to 2020 and 2022, especially in surface waters. The maximum surface TA value in August/September 2021 was 2017 μmol kg",{"sup":1662},[1663],{"#text":978},{"#text":1665},", as compared to 2070 and 2069 μmol kg",{"sup":1667},[1668],{"#text":978},{"#text":1670}," in 2020 and 2022, respectively. In eastern LIS (ELIS), the influence of increased Connecticut River discharge in September 2021 is clear, as the region near the river mouth was locally depleted in TA, with a value of ~1875 μmol kg",{"sup":1672},[1673],{"#text":978},{"#text":1675}," as compared to surrounding values 50-100 μmol kg",{"sup":1677},[1678],{"#text":978},{"#text":1680}," higher.",{"#text":809},{"fig":1683,":@":1735},[1684,1685,1689,1690,1729,1730,1734],{"#text":803},{"label":1686},[1687],{"#text":1688},"Figure 3",{"#text":803},{"caption":1691},[1692,1693,1728],{"#text":1209},{"p":1694},[1695,1697,1700,1702,1705,1707,1710,1712,1715,1717,1720,1722,1726],{"#text":1696},"The relationship between salinity and ",{"bold":1698},[1699],{"#text":1541},{"#text":1701}," total alkalinity (R",{"sup":1703},[1704],{"#text":878},{"#text":1706}," = 0.59, p \u003C 10",{"sup":1708},[1709],{"#text":1638},{"#text":1711},", n = 178) and ",{"bold":1713},[1714],{"#text":1547},{"#text":1716}," dissolved inorganic carbon (R",{"sup":1718},[1719],{"#text":878},{"#text":1721}," = 0.38, p \u003C 10",{"sup":1723},[1724],{"#text":1725},"-21",{"#text":1727},", n = 200) across the study period. The marker color represents different sampling events, and marker shape represents the month of sampling. Note the different y-axis scales for each subplot.",{"#text":803},{"#text":803},{"graphic":1731,":@":1732},[],{"@_mimetype":380,"@_mime-subtype":1219,"@_xlink:href":1733},"fmars-11-1398087-g003.tif",{"#text":809},{"@_id":1653,"@_position":1224},{"#text":809},{"p":1738},[1739,1741,1744,1746,1749,1750,1753,1755,1762,1764,1767,1769,1776,1778,1781,1783,1786,1788,1791],{"#text":1740},"Because DIC includes the concentration of CO",{"sub":1742},[1743],{"#text":878},{"#text":1745},", it is more strongly affected by biological activity than TA. WLIS is highly productive in the summer, so DIC displayed more spatial and seasonal variation than TA, but still correlated strongly with salinity (p \u003C 10",{"sup":1747},[1748],{"#text":1725},{"#text":1640},{"sup":1751},[1752],{"#text":878},{"#text":1754}," = 0.38, n = 200, ",{"xref":1756,":@":1761},[1757],{"bold":1758},[1759],{"#text":1760},"Figure 3B",{"@_ref-type":1152,"@_rid":1653},{"#text":1763},"). During the study period, DIC in surface and bottom waters ranged from 1678 – 1908 and 1704 -1984 μmol kg",{"sup":1765},[1766],{"#text":978},{"#text":1768},", respectively, generally increasing with depth and towards the estuary mouth. The vertical gradient in DIC had a strong seasonal variation, with the largest gradient occurring in the stratified summer months and the smallest gradient in the fall (",{"xref":1770,":@":1775},[1771],{"bold":1772},[1773],{"#text":1774},"Supplementary Figure 3",{"@_ref-type":1237,"@_rid":1238},{"#text":1777},"). In the summer, high productivity in the surface waters depressed DIC, while comparatively, DIC was elevated in deeper waters, consistent with intense stratification and subsurface respiration of organic matter. As with TA, the interannual variation of DIC was dominated by autumn minima in 2021 as compared to 2020 and 2022. In October 2020 and August 2022, surface DIC values were ~1850-1900 μmol kg",{"sup":1779},[1780],{"#text":978},{"#text":1782},". By contrast, in September and October of 2021, DIC was always less than 1800 μmol kg",{"sup":1784},[1785],{"#text":978},{"#text":1787}," and was as low as 1680 μmol kg",{"sup":1789},[1790],{"#text":978},{"#text":1792}," in WLIS.",{"#text":809},{"p":1795},[1796,1798,1801,1803,1806,1808,1814,1816,1819,1821,1824,1826,1830,1832,1835,1836,1843,1845,1848,1850,1853,1855,1858,1860,1863,1865,1868],{"#text":1797},"Aragonite saturation state (Ω",{"sub":1799},[1800],{"#text":884},{"#text":1802},") was calculated from TA and DIC measurements, yielding a mean propagated error of 0.04 units. Ω",{"sub":1804},[1805],{"#text":884},{"#text":1807}," is an important acidification metric to consider for calcifying organisms sensitive to carbonate ion concentrations (",{"xref":1809,":@":1812},[1810],{"#text":1811},"Waldbusser et al., 2015",{"@_ref-type":920,"@_rid":1813},"B48",{"#text":1815},"), though species-specific thresholds are not well-defined in this region. In general, Ω",{"sub":1817},[1818],{"#text":884},{"#text":1820}," \u003C 1 (aragonite undersaturation) is considered deleterious to calcifying organisms, as aragonite dissolution is thermodynamically favored. However, Ω",{"sub":1822},[1823],{"#text":884},{"#text":1825}," \u003C 1.5 or higher can still be a detrimental condition depending on the organism and its life stage (",{"xref":1827,":@":1829},[1828],{"#text":1081},{"@_ref-type":920,"@_rid":1083},{"#text":1831},"). The trend in Ω",{"sub":1833},[1834],{"#text":884},{"#text":952},{"xref":1837,":@":1842},[1838],{"bold":1839},[1840],{"#text":1841},"Supplementary Figure 4",{"@_ref-type":1237,"@_rid":1238},{"#text":1844},") closely followed that of DIC, with a strong summertime along-estuary gradient in surface waters. Ω",{"sub":1846},[1847],{"#text":884},{"#text":1849}," ranged from 0.87 – 3.01 and 0.59 – 2.77 in surface and bottom waters, respectively. Notably, the lowest Ω",{"sub":1851},[1852],{"#text":884},{"#text":1854}," values were observed during summer 2020, during which much of WLIS bottom waters were aragonite undersaturated for at least three sampling events spanning six weeks in July and August. Ω",{"sub":1856},[1857],{"#text":884},{"#text":1859}," was low, but exceeded 1, in WLIS during summer 2022. In summer 2021, a year with anomalously high precipitation rates, bottom water Ω",{"sub":1861},[1862],{"#text":884},{"#text":1864}," always exceeded 1.3. Despite lower summertime estuary-wide TA due to increased freshwater discharge, Ω",{"sub":1866},[1867],{"#text":884},{"#text":1869}," remained oversaturated in bottom waters due to concurrent low DIC, and thus a low ratio of DIC to TA.",{"#text":809},{"p":1872},[1873,1875,1878,1880,1888,1890,1893,1895,1898,1900,1904,1906,1909,1911,1915,1917,1920,1922,1928,1929,1935,1937,1940,1942,1945,1947,1950,1952,1956],{"#text":1874},"Assuming that Ω",{"sub":1876},[1877],{"#text":884},{"#text":1879}," is primarily biologically mediated (via photosynthesis/respiration and calcification/dissolution), we expect a strong relationship with apparent oxygen utilization (AOU), especially during the stratified summer season. AOU describes the difference between the observed dissolved oxygen (DO) concentration and that at saturation. Positive and negative AOU values indicate DO under- and over-saturation, respectively. The use of AOU as a proxy for photosynthesis and respiration has the limitation that oxygen equilibrates rapidly in the surface mixed layer and can be advected from adjacent water parcels, so the AOU of a given water parcel does not solely reflect oxygen production or utilization in that location. However, AOU is still useful for a coarse estimate of biological oxygen consumption and production. ",{"xref":1881,":@":1886},[1882],{"bold":1883},[1884],{"#text":1885},"Figure 4",{"@_ref-type":1152,"@_rid":1887},"f4",{"#text":1889}," shows the relationship between Ω",{"sub":1891},[1892],{"#text":884},{"#text":1894}," and AOU during this study period. While the two parameters showed strong correlation in 2020 (R",{"sup":1896},[1897],{"#text":878},{"#text":1899}," = 0.70, p \u003C 10",{"sup":1901},[1902],{"#text":1903},"-16",{"#text":1905},", n = 68) and 2022 (R",{"sup":1907},[1908],{"#text":878},{"#text":1910}," = 0.51, p \u003C 0.001, n = 23), the relationship was less significant during 2021 (R",{"sup":1912},[1913],{"#text":1914},"2 =",{"#text":1916}," 0.07, p \u003C 0.10, n = 48). Longer estuarine residence times enhance subsurface oxygen depletion and CO",{"sub":1918},[1919],{"#text":878},{"#text":1921}," accumulation (e.g., ",{"xref":1923,":@":1926},[1924],{"#text":1925},"Vlahos and Whitney, 2017",{"@_ref-type":920,"@_rid":1927},"B47",{"#text":939},{"xref":1930,":@":1933},[1931],{"#text":1932},"Zeldis et al., 2022",{"@_ref-type":920,"@_rid":1934},"B55",{"#text":1936},"), which likely explains the reduced correlation between AOU and Ω",{"sub":1938},[1939],{"#text":884},{"#text":1941}," during high-discharge conditions leading to shorter residence time. For the entire dataset, the relationship between Ω",{"sub":1943},[1944],{"#text":884},{"#text":1946}," and AOU was significant (R",{"sup":1948},[1949],{"#text":878},{"#text":1951}," = 0.26, p \u003C 10",{"sup":1953},[1954],{"#text":1955},"-9",{"#text":1957},", n = 139).",{"#text":809},{"fig":1960,":@":2015},[1961,1962,1965,1966,2009,2010,2014],{"#text":803},{"label":1963},[1964],{"#text":1885},{"#text":803},{"caption":1967},[1968,1969,2008],{"#text":1209},{"p":1970},[1971,1973,1976,1978,1981,1983,1986,1987,1990,1992,1995,1997,2000,2002,2006],{"#text":1972},"The relationship between aragonite saturation state (Ω",{"sub":1974},[1975],{"#text":884},{"#text":1977},") calculated from TA and DIC and ",{"bold":1979},[1980],{"#text":1541},{"#text":1982}," apparent oxygen utilization (AOU) (R",{"sup":1984},[1985],{"#text":878},{"#text":1951},{"sup":1988},[1989],{"#text":1955},{"#text":1991},", n = 139), ",{"bold":1993},[1994],{"#text":1547},{"#text":1996}," DIC/TA (R",{"sup":1998},[1999],{"#text":878},{"#text":2001}," = 0.98, p \u003C 10",{"sup":2003},[2004],{"#text":2005},"-100",{"#text":2007},", n = 139) from March 2020 – August 2022. Marker color represents different sampling events, and marker shape represents the month of sampling.",{"#text":803},{"#text":803},{"graphic":2011,":@":2012},[],{"@_mimetype":380,"@_mime-subtype":1219,"@_xlink:href":2013},"fmars-11-1398087-g004.tif",{"#text":809},{"@_id":1887,"@_position":1224},{"#text":809},{"p":2018},[2019,2021,2024,2026,2029,2031,2034,2036,2042,2044,2047,2049,2056,2057,2060,2061,2064],{"#text":2020},"The ratio of DIC to TA (DIC/TA) is another proxy for acidification that is more straightforward and precise than Ω",{"sub":2022},[2023],{"#text":884},{"#text":2025},", as it relies on simple division of two measured parameters rather than calculations using empirical constants. DIC consists of CO",{"sub":2027},[2028],{"#text":878},{"#text":2030},", bicarbonate, and carbonate, while TA consists of carbonate (contributing twice as much to TA as to DIC), bicarbonate, and other proton acceptors. Thus, higher DIC/TA indicates a greater proportion of CO",{"sub":2032},[2033],{"#text":878},{"#text":2035}," and thus more acidified waters, while lower DIC/TA indicates a more buffered water mass. For context, the seawater endmember of DIC/TA is ~0.87 (",{"xref":2037,":@":2040},[2038],{"#text":2039},"Cai et al., 2020",{"@_ref-type":920,"@_rid":2041},"B4",{"#text":2043},"). In this study, DIC/TA ranged from 0.86 (WLIS surface, September 2021) to 1.00 (ELIS bottom, July 2020). The highest DIC/TA values (most acidified) were generally observed during 2020 (0.88 – 1.00, median 0.94, n = 69) and the lowest values (least acidified) during 2021 (0.86 – 0.95, median 0.91, n = 48), with 2022 falling in the middle (0.90 – 0.96, median 0.92, n = 23), indicating that LIS was overall better buffered during the high-precipitation summer (2021) than in the drought summers (2020 and 2022). DIC/TA and Ω",{"sub":2045},[2046],{"#text":884},{"#text":2048}," were strongly negatively correlated for the entire study period (",{"xref":2050,":@":2055},[2051],{"bold":2052},[2053],{"#text":2054},"Figure 4B",{"@_ref-type":1152,"@_rid":1887},{"#text":1640},{"sup":2058},[2059],{"#text":878},{"#text":2001},{"sup":2062},[2063],{"#text":2005},{"#text":1957},{"#text":893},{"@_id":2067},"s3_2",{"#text":893},{"sec":2070,":@":2601},[2071,2072,2076,2077,2135,2136,2505,2506,2600],{"#text":1135},{"title":2073},[2074],{"#text":2075},"3.3 Interactions with hypoxia",{"#text":809},{"p":2078},[2079,2081,2084,2086,2089,2091,2097,2098,2102,2104,2107,2109,2112,2114,2117,2119,2122,2124,2133],{"#text":2080},"Hypoxia (defined as DO \u003C 3 mg L",{"sup":2082},[2083],{"#text":978},{"#text":2085}," or ~94 μmol kg",{"sup":2087},[2088],{"#text":978},{"#text":2090}," in LIS) has decreased in duration and extent due to mandated reductions in nitrogen emissions to the estuary (",{"xref":2092,":@":2095},[2093],{"#text":2094},"Whitney and Vlahos, 2021",{"@_ref-type":920,"@_rid":2096},"B52",{"#text":939},{"xref":2099,":@":2101},[2100],{"#text":1062},{"@_ref-type":920,"@_rid":1064},{"#text":2103},"). The hypoxic duration and extent in 2020 (43 d and 163 km",{"sup":2105},[2106],{"#text":878},{"#text":2108},", respectively) were among the lowest observed in LIS since the implementation of the nitrogen TMDL in 2000. In 2021, hypoxic duration and extent were 47 d and 368 km",{"sup":2110},[2111],{"#text":878},{"#text":2113},", respectively, while in 2022, hypoxic duration and extent were 57 d and 225 km",{"sup":2115},[2116],{"#text":878},{"#text":2118},", respectively. The hypoxic area of LIS during all three years represented in this study was below the 539 km",{"sup":2120},[2121],{"#text":878},{"#text":2123}," average for the entire time series from 1991-2021. ",{"xref":2125,":@":2130},[2126],{"bold":2127},[2128],{"#text":2129},"Table 1",{"@_ref-type":2131,"@_rid":2132},"table","T1",{"#text":2134}," summarizes these trends.",{"#text":809},{"table-wrap":2137,":@":2504},[2138,2139,2142,2143,2156,2157,2468,2469,2503],{"#text":803},{"label":2140},[2141],{"#text":2129},{"#text":803},{"caption":2144},[2145,2146,2155],{"#text":1209},{"p":2147},[2148,2150,2153],{"#text":2149},"Western LIS (west of longitude -73.0) summertime (July – September) average bottom water hypoxic area, Housatonic River discharge, DIC, TA, DIC/TA, and Ω",{"sub":2151},[2152],{"#text":884},{"#text":2154}," by year.",{"#text":803},{"#text":803},{"table":2158,":@":2466},[2159,2160,2256,2257,2465],{"#text":1209},{"thead":2161},[2162,2164,2255],{"#text":2163},"\n              ",{"tr":2165},[2166,2168,2175,2176,2190,2191,2199,2200,2219,2220,2229,2230,2239,2240,2245,2246,2254],{"#text":2167},"\n                ",{"th":2169,":@":2172},[2170],{"#text":2171},"Year",{"@_valign":2173,"@_align":2174},"middle","center",{"#text":2167},{"th":2177,":@":2189},[2178,2180,2183,2185],{"#text":2179},"Hypoxic Area (km",{"sup":2181},[2182],{"#text":878},{"#text":2184},")",{"sup":2186},[2187],{"#text":2188},"a",{"@_valign":2173,"@_align":2174},{"#text":2167},{"th":2192,":@":2198},[2193,2195],{"#text":2194},"Hypoxic Duration (d)",{"sup":2196},[2197],{"#text":2188},{"@_valign":2173,"@_align":2174},{"#text":2167},{"th":2201,":@":2218},[2202,2204,2208,2210,2213,2214],{"#text":2203},"Housatonic River Discharge (m",{"sup":2205},[2206],{"#text":2207},"3",{"#text":2209}," s",{"sup":2211},[2212],{"#text":978},{"#text":2184},{"sup":2215},[2216],{"#text":2217},"b",{"@_valign":2173,"@_align":2174},{"#text":2167},{"th":2221,":@":2228},[2222,2224,2227],{"#text":2223},"Average DIC (μmol kg",{"sup":2225},[2226],{"#text":978},{"#text":2184},{"@_valign":2173,"@_align":2174},{"#text":2167},{"th":2231,":@":2238},[2232,2234,2237],{"#text":2233},"Average TA (μmol kg",{"sup":2235},[2236],{"#text":978},{"#text":2184},{"@_valign":2173,"@_align":2174},{"#text":2167},{"th":2241,":@":2244},[2242],{"#text":2243},"Average DIC/TA",{"@_valign":2173,"@_align":2174},{"#text":2167},{"th":2247,":@":2253},[2248,2250],{"#text":2249},"Average Ω",{"sub":2251},[2252],{"#text":884},{"@_valign":2173,"@_align":2174},{"#text":2163},{"#text":1209},{"#text":1209},{"tbody":2258},[2259,2260,2312,2313,2364,2365,2416,2417,2464],{"#text":2163},{"tr":2261},[2262,2263,2268,2269,2274,2275,2281,2282,2287,2288,2293,2294,2299,2300,2305,2306,2311],{"#text":2167},{"td":2264,":@":2267},[2265],{"#text":2266},"2020",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2270,":@":2273},[2271],{"#text":2272},"163",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2276,":@":2279},[2277],{"#text":2278},"43",{"@_valign":2280,"@_align":2174},"top",{"#text":2167},{"td":2283,":@":2286},[2284],{"#text":2285},"17 ± 13",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2289,":@":2292},[2290],{"#text":2291},"1909.7 ± 31.0",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2295,":@":2298},[2296],{"#text":2297},"1933.3 ± 11.8",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2301,":@":2304},[2302],{"#text":2303},"0.977 ± 0.014",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2307,":@":2310},[2308],{"#text":2309},"0.88 ± 0.22",{"@_valign":2173,"@_align":2174},{"#text":2163},{"#text":2163},{"tr":2314},[2315,2316,2321,2322,2327,2328,2333,2334,2339,2340,2345,2346,2351,2352,2357,2358,2363],{"#text":2167},{"td":2317,":@":2320},[2318],{"#text":2319},"2021",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2323,":@":2326},[2324],{"#text":2325},"368",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2329,":@":2332},[2330],{"#text":2331},"47",{"@_valign":2280,"@_align":2174},{"#text":2167},{"td":2335,":@":2338},[2336],{"#text":2337},"137 ± 118",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2341,":@":2344},[2342],{"#text":2343},"1789.2 ± 34.8",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2347,":@":2350},[2348],{"#text":2349},"1951.6 ± 18.6",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2353,":@":2356},[2354],{"#text":2355},"0.914 ± 0.012",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2359,":@":2362},[2360],{"#text":2361},"1.98 ± 0.23",{"@_valign":2173,"@_align":2174},{"#text":2163},{"#text":2163},{"tr":2366},[2367,2368,2373,2374,2379,2380,2385,2386,2391,2392,2397,2398,2403,2404,2409,2410,2415],{"#text":2167},{"td":2369,":@":2372},[2370],{"#text":2371},"2022",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2375,":@":2378},[2376],{"#text":2377},"225",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2381,":@":2384},[2382],{"#text":2383},"57",{"@_valign":2280,"@_align":2174},{"#text":2167},{"td":2387,":@":2390},[2388],{"#text":2389},"15 ± 7",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2393,":@":2396},[2394],{"#text":2395},"1927.9 ± 20.1",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2399,":@":2402},[2400],{"#text":2401},"1999.5 ± 12.0",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2405,":@":2408},[2406],{"#text":2407},"0.963 ± 0.000",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2411,":@":2414},[2412],{"#text":2413},"1.09 ± 0.00",{"@_valign":2173,"@_align":2174},{"#text":2163},{"#text":2163},{"tr":2418},[2419,2420,2425,2426,2431,2432,2437,2438,2443,2444,2448,2449,2453,2454,2458,2459,2463],{"#text":2167},{"td":2421,":@":2424},[2422],{"#text":2423},"1990-2021",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2427,":@":2430},[2428],{"#text":2429},"538",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2433,":@":2436},[2434],{"#text":2435},"52",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2439,":@":2442},[2440],{"#text":2441},"–",{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2445,":@":2447},[2446],{"#text":2441},{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2450,":@":2452},[2451],{"#text":2441},{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2455,":@":2457},[2456],{"#text":2441},{"@_valign":2173,"@_align":2174},{"#text":2167},{"td":2460,":@":2462},[2461],{"#text":2441},{"@_valign":2173,"@_align":2174},{"#text":2163},{"#text":1209},{"#text":803},{"@_frame":2467},"hsides",{"#text":803},{"table-wrap-foot":2470},[2471,2472,2502],{"#text":1209},{"fn":2473},[2474,2475,2501],{"#text":2163},{"p":2476},[2477,2478,2481,2483,2488,2490,2493,2495,2500],{"#text":2167},{"sup":2479},[2480],{"#text":2188},{"#text":2482},"Hypoxic area and duration from ",{"xref":2484,":@":2487},[2485],{"#text":2486},"Long Island Sound Study (2022)",{"@_ref-type":920,"@_rid":1064},{"#text":2489},". ",{"sup":2491},[2492],{"#text":2217},{"#text":2494},"Housatonic River discharge from ",{"xref":2496,":@":2499},[2497],{"#text":2498},"USGS (2022a)",{"@_ref-type":920,"@_rid":1561},{"#text":1471},{"#text":1209},{"#text":803},{"#text":809},{"@_id":2132,"@_position":1224},{"#text":809},{"p":2507},[2508,2510,2513,2515,2519,2520,2524,2525,2531,2533,2539,2541,2544,2546,2549,2551,2554,2556,2560,2562,2565,2567,2570,2572,2575,2577,2580,2582,2585,2587,2590,2591,2598],{"#text":2509},"In many cases, estuarine eutrophication leads to concurrent low-DO and high-CO",{"sub":2511},[2512],{"#text":878},{"#text":2514}," conditions (",{"xref":2516,":@":2518},[2517],{"#text":956},{"@_ref-type":920,"@_rid":958},{"#text":939},{"xref":2521,":@":2523},[2522],{"#text":970},{"@_ref-type":920,"@_rid":972},{"#text":939},{"xref":2526,":@":2529},[2527],{"#text":2528},"Shen et al., 2022",{"@_ref-type":920,"@_rid":2530},"B40",{"#text":2532},"), though these conditions may be temporally and spatially decoupled (",{"xref":2534,":@":2537},[2535],{"#text":2536},"Shen et al., 2023",{"@_ref-type":920,"@_rid":2538},"B41",{"#text":2540},"). While the most intense hypoxia was consistently observed at WLIS station A4 in August for the three study years, the co-occurring acidification trends were more variable. In 2020, a drought summer, though TA and thus Ω",{"sub":2542},[2543],{"#text":884},{"#text":2545}," data were not available for bottom waters during August, the lowest DO observed (55.3 μmol L",{"sup":2547},[2548],{"#text":978},{"#text":2550},", station A4, WQAug20) was concurrent with a bottom-water DIC maximum (1984.2 μmol kg",{"sup":2552},[2553],{"#text":978},{"#text":2555},") and pH",{"sub":2557},[2558],{"#text":2559},"nbs",{"#text":2561}," minimum (7.6). In 2021, the high-precipitation summer, the lowest observed DO (58.1 μmol L",{"sup":2563},[2564],{"#text":978},{"#text":2566},", station A4, HYAug21) was similar to the concentration observed in 2020, but DIC was much lower (1839.7 μmol kg",{"sup":2568},[2569],{"#text":978},{"#text":2571},") while Ω",{"sub":2573},[2574],{"#text":884},{"#text":2576}," was 1.79, well above saturation conditions. Finally, in 2022, the lowest observed DO (44.7 μmol L",{"sup":2578},[2579],{"#text":978},{"#text":2581},", station A4, WQAug22) occurred with low Ω",{"sub":2583},[2584],{"#text":884},{"#text":2586}," (1.09) and elevated DIC (1946.2 μmol kg",{"sup":2588},[2589],{"#text":978},{"#text":1457},{"xref":2592,":@":2597},[2593],{"bold":2594},[2595],{"#text":2596},"Supplementary Figure 5",{"@_ref-type":1237,"@_rid":1238},{"#text":2599}," shows the cross-sectional distribution of DO for each sampling event. In summary, the co-occurrence of hypoxia and acidification was clear for times of drought in 2020 and 2022, but not for the summer with high precipitation (2021).",{"#text":893},{"@_id":2602},"s3_3",{"#text":896},{"@_id":2605,"@_sec-type":2606},"s3","results",{"#text":896},{"sec":2609,":@":3106,"anchorId":3107},[2610,2611,2615,2616,2942,2943,3073,3074,3105],{"#text":900},{"title":2612},[2613],{"#text":2614},"4 Discussion",{"#text":893},{"sec":2617,":@":2940},[2618,2619,2623,2624,2628,2629,2675,2676,2733,2734,2776,2777,2816,2817,2873,2874,2918,2919,2939],{"#text":1135},{"title":2620},[2621],{"#text":2622},"4.1 Freshwater endmember variability",{"#text":809},{"p":2625},[2626],{"#text":2627},"Though the spatial extent of this study captured both western and eastern LIS, this discussion primarily focuses on western LIS (WLIS), as that is the region where the most severe hypoxia and acidification have been observed.",{"#text":809},{"p":2630},[2631,2633,2639,2640,2644,2646,2650,2652,2655,2657,2660,2662,2665,2667,2673],{"#text":2632},"Of the three study years, the carbonate system dynamics of 2020 and 2022 were comparable, while 2021 showed a divergent pattern. 2020 and 2022 were both drought years, with especially low freshwater discharge during the summer, while in 2021 there was increased freshwater input, primarily due to tropical storms. In some estuaries, lower river discharge is associated with reduced hypoxia, as reduced freshwater flow leads to less nutrient loading, lower primary productivity, and less organic material fueling microbial respiration (",{"xref":2634,":@":2637},[2635],{"#text":2636},"Zheng et al., 2016",{"@_ref-type":920,"@_rid":2638},"B56",{"#text":939},{"xref":2641,":@":2643},[2642],{"#text":2528},{"@_ref-type":920,"@_rid":2530},{"#text":2645},"). By contrast, in LIS low-flow years have been shown to be net heterotrophic, as longer estuarine residence time leads to DO depletion, despite the reduced source of allochthonous organic material (",{"xref":2647,":@":2649},[2648],{"#text":1925},{"@_ref-type":920,"@_rid":1927},{"#text":2651},"). Despite the slightly greater hypoxic area observed in 2021 (368 km",{"sup":2653},[2654],{"#text":878},{"#text":2656},") relative to 2020 and 2022 (163 and 225 km",{"sup":2658},[2659],{"#text":878},{"#text":2661},", respectively), the entire study period had hypoxic conditions well below the mean area (538 km",{"sup":2663},[2664],{"#text":878},{"#text":2666},") for the monitoring period 1991-2021 (see ",{"xref":2668,":@":2672},[2669],{"bold":2670},[2671],{"#text":2129},{"@_ref-type":2131,"@_rid":2132},{"#text":2674},"). However, the westernmost sampling station A4 still displayed hypoxic conditions in bottom waters for several weeks of monitoring during each sampling year. Thus, freshwater discharge conditions did not appear to substantially impact summertime hypoxia in LIS during the study period.",{"#text":809},{"p":2677},[2678,2680,2686,2688,2691,2693,2699,2700,2706,2708,2711,2713,2719,2720,2726,2728,2731],{"#text":2679},"During the timing of minimum DO concentration (July-August), hypoxic conditions were relatively similar in the bottom waters of WLIS (",{"xref":2681,":@":2685},[2682],{"bold":2683},[2684],{"#text":2596},{"@_ref-type":1237,"@_rid":1238},{"#text":2687},") for all three years, but DIC was nearly 100 μmol kg",{"sup":2689},[2690],{"#text":978},{"#text":2692}," higher in the drought summers 2020 and 2022 as compared to the wet summer in 2021 (",{"xref":2694,":@":2698},[2695],{"bold":2696},[2697],{"#text":2129},{"@_ref-type":2131,"@_rid":2132},{"#text":939},{"xref":2701,":@":2705},[2702],{"bold":2703},[2704],{"#text":1774},{"@_ref-type":1237,"@_rid":1238},{"#text":2707},"). Ω",{"sub":2709},[2710],{"#text":884},{"#text":2712}," was also substantially higher in 2021 than in 2020 and 2022 (",{"xref":2714,":@":2718},[2715],{"bold":2716},[2717],{"#text":2129},{"@_ref-type":2131,"@_rid":2132},{"#text":939},{"xref":2721,":@":2725},[2722],{"bold":2723},[2724],{"#text":1841},{"@_ref-type":1237,"@_rid":1238},{"#text":2727},"). This indicates that the variation in freshwater discharge had more influence on bottom-water acidification than on hypoxia. We propose that these differences are due to differences in the chemistry of the freshwater endmember, variable proportions of fresh- and seawater endmembers, the differing equilibration times for oxygen and CO",{"sub":2729},[2730],{"#text":878},{"#text":2732},", and variability in estuarine residence time.",{"#text":809},{"p":2735},[2736,2738,2744,2746,2750,2752,2755,2757,2763,2765,2768,2770,2774],{"#text":2737},"DIC and TA data are available for freshwater endmembers in the Connecticut and Housatonic Rivers during 2020 and 2021 (",{"xref":2739,":@":2742},[2740],{"#text":2741},"McGuinness, 2022",{"@_ref-type":920,"@_rid":2743},"B30",{"#text":2745},"), overlapping with two of the three years in this study. These two rivers account on average for ~55 and 25% of the freshwater content in WLIS, respectively (",{"xref":2747,":@":2749},[2748],{"#text":1188},{"@_ref-type":920,"@_rid":1190},{"#text":2751},"). The Housatonic River, which discharges near the eastern boundary of WLIS, has relatively higher TA (averaging 1578 ± 236 μmol L",{"sup":2753},[2754],{"#text":978},{"#text":2756}," during 2020-2021) than the Connecticut River, likely due to the presence of carbonate rock formations in the watershed (",{"xref":2758,":@":2761},[2759],{"#text":2760},"Robinson and Kapo, 2003",{"@_ref-type":920,"@_rid":2762},"B37",{"#text":2764},"). However, the main geologic formation of the Housatonic watershed is composed of slates and pelitic metasedimentary rocks. By contrast, the Connecticut River has relatively lower TA (averaging 531 ± 110 μmol L",{"sup":2766},[2767],{"#text":978},{"#text":2769}," during 2020-2021) as it primarily flows through granite and gneiss bedrocks, though there are some carbonate-containing formations in central Connecticut (",{"xref":2771,":@":2773},[2772],{"#text":2760},{"@_ref-type":920,"@_rid":2762},{"#text":2775},"). WLIS may have a more substantial source of freshwater alkalinity, especially under high-flow conditions, as it contains a greater proportion of Housatonic River outflow than ELIS.",{"#text":809},{"p":2778},[2779,2781,2784,2786,2789,2791,2794,2796,2799,2801,2804,2806,2809,2811,2814],{"#text":2780},"While river TA was variable among sampling events, there was no statistically significant relationship with discharge (Connecticut: R",{"sup":2782},[2783],{"#text":878},{"#text":2785}," = 0.06, p = 0.52, n = 8, Housatonic: R",{"sup":2787},[2788],{"#text":878},{"#text":2790}," = 0.05, p = 0.59, n = 8). However, river DIC was negatively correlated with discharge for 2020-2021 (Connecticut: R",{"sup":2792},[2793],{"#text":878},{"#text":2795}," = 0.72, p = 0.004, n = 9, Housatonic: R",{"sup":2797},[2798],{"#text":878},{"#text":2800}," = 0.64, p = 0.02, n = 8), and thus DIC/TA was also negatively correlated with discharge (Connecticut: R",{"sup":2802},[2803],{"#text":878},{"#text":2805}," = 0.45, p = 0.07, n = 8, Housatonic: R",{"sup":2807},[2808],{"#text":878},{"#text":2810}," = 0.81, p = 0.01, n = 6). River DIC likely decreased under elevated river discharge because of a shorter residence time for organic matter respiration and CO",{"sub":2812},[2813],{"#text":878},{"#text":2815}," accumulation.",{"#text":809},{"p":2818},[2819,2821,2829,2831,2834,2836,2839,2841,2844,2846,2851,2853,2856,2858,2861,2863,2866,2868,2871],{"#text":2820},"The increased buffering capacity of the Housatonic and Connecticut Rivers under high discharge conditions, as indicated by decreased DIC/TA, influenced the acid-base chemistry of WLIS during summer/fall 2021 (",{"xref":2822,":@":2827},[2823],{"bold":2824},[2825],{"#text":2826},"Figure 5",{"@_ref-type":1152,"@_rid":2828},"f5",{"#text":2830},"). Though bottom-water TA was relatively consistent in WLIS during the study period, DIC and thus DIC/TA were much lower in 2021 than in 2020 and 2022. This explains the relatively higher Ω",{"sub":2832},[2833],{"#text":884},{"#text":2835}," (> 1.5) in WLIS bottom waters during peak hypoxia in 2021, relative to the undersaturated (Ω",{"sub":2837},[2838],{"#text":884},{"#text":2840}," \u003C 1) and near saturated (Ω",{"sub":2842},[2843],{"#text":884},{"#text":2845}," \u003C 1.1) conditions in the drought summers of 2020 and 2022, respectively. In 2012, ",{"xref":2847,":@":2850},[2848],{"#text":2849},"Wallace et al. (2014)",{"@_ref-type":920,"@_rid":972},{"#text":2852}," also showed summertime aragonite undersaturation in the bottom waters of WLIS co-occurring with hypoxic conditions. Hypoxic extent was relatively high (747 km",{"sup":2854},[2855],{"#text":878},{"#text":2857},") in 2012 relative to the 1991-2021 average of 538 km",{"sup":2859},[2860],{"#text":878},{"#text":2862},". 2012 was also a historic drought year in Connecticut, on par with the conditions of 2020 and 2022. Though river chemistry data is not available for the 2012 study, it is likely that low river discharge increased the DIC/TA value of the freshwater endmember, reducing the buffering capacity of WLIS. The increased water residence time associated with drought likely also contributed to the depletion of O",{"sub":2864},[2865],{"#text":878},{"#text":2867}," and the accumulation of CO",{"sub":2869},[2870],{"#text":878},{"#text":2872},". Our observations during a high-flow year (2021) indicate that the conditions leading to hypoxic conditions in LIS do not always simultaneously induce acidification. The buffering capacity of the incoming freshwater appears to play a role in mitigating or exacerbating summertime acidification.",{"#text":809},{"fig":2875,":@":2917},[2876,2877,2880,2881,2911,2912,2916],{"#text":803},{"label":2878},[2879],{"#text":2826},{"#text":803},{"caption":2882},[2883,2884,2910],{"#text":1209},{"p":2885},[2886,2888,2891,2893,2896,2898,2902,2904,2908],{"#text":2887},"Time series of ",{"bold":2889},[2890],{"#text":1541},{"#text":2892}," Connecticut (solid line) and Housatonic (dash-dotted line) River discharge, ",{"bold":2894},[2895],{"#text":1547},{"#text":2897}," Connecticut (black circles) and Housatonic (gray diamonds) River DIC/TA ratios, and ",{"bold":2899},[2900],{"#text":2901},"(C)",{"#text":2903}," area-averaged DIC/TA ratios for and WLIS surface (white squares) and bottom (gray squares) DIC/TA ratios during the study period. Here, E and WLIS are separated at the -73° meridian. Surface waters samples were collected ~2 m from the surface, while bottom water samples were collected ~2 m from the bottom, which is variable from ~15-45 m across LIS. The orange and blue shaded boxes indicate periods of drought (SPI \u003C -1.6 for at least 50% of Connecticut land) and wet (SPI > 1.6 for at least 50% of Connecticut) conditions (",{"xref":2905,":@":2907},[2906],{"#text":1594},{"@_ref-type":920,"@_rid":1056},{"#text":2909},"). For readers in greyscale, refer to the symbols above each banded section (‡ = drought, * = wet).",{"#text":803},{"#text":803},{"graphic":2913,":@":2914},[],{"@_mimetype":380,"@_mime-subtype":1219,"@_xlink:href":2915},"fmars-11-1398087-g005.tif",{"#text":809},{"@_id":2828,"@_position":1224},{"#text":809},{"p":2920},[2921,2923,2929,2931,2937],{"#text":2922},"Though precipitation in the northeast US is expected to increase under climate change, most of this increase is predicted to occur in the winter and spring, with little change in the summer (",{"xref":2924,":@":2927},[2925],{"#text":2926},"USGCRP, 2018",{"@_ref-type":920,"@_rid":2928},"B43",{"#text":2930},"). By contrast, late summer and fall streamflow are expected to decrease due to a greater chance for summertime drought (",{"xref":2932,":@":2935},[2933],{"#text":2934},"Demaria et al., 2016",{"@_ref-type":920,"@_rid":2936},"B6",{"#text":2938},"). If these regional projections hold true for the LIS watershed, a decrease in alkalinity loading from the Housatonic River and an increase in freshwater DIC may exacerbate late summer acidification in WLIS.",{"#text":893},{"@_id":2941},"s4_1",{"#text":893},{"sec":2944,":@":3071},[2945,2946,2950,2951,2955,2956,2995,2996,3065,3066,3070],{"#text":1135},{"title":2947},[2948],{"#text":2949},"4.2 Comparison to other major US estuaries",{"#text":809},{"p":2952},[2953],{"#text":2954},"The unique hydrodynamics of LIS can complicate comparisons to other estuaries. While most US east coast estuaries have deltaic features, with the main freshwater source at the head mixing gradually with seawater towards the mouth, LIS was formed through the glacial deposition of Long Island, and the largest freshwater source (Connecticut River) is near its mouth. Despite these unique physical characteristics, valuable comparisons can be made regarding the summertime stratification, hypoxia, and acidification displayed in other major US estuaries including the Delaware Bay and Gulf of Mexico. These estuaries are discussed due to their data availability and comparable dynamics to LIS.",{"#text":809},{"p":2957},[2958,2960,2963,2965,2968,2969,2975,2977,2981,2983,2988,2990,2993],{"#text":2959},"Delaware Bay is a drowned river valley or coastal plain estuary which is a tributary of the mid-Atlantic Bight and receives its largest freshwater input from the Delaware River at the estuary head. Delaware Bay has a similar seasonal weather pattern as LIS, and the chemistry of both the fresh- and seawater endmembers are relatively similar, though TA is higher in the Housatonic River (1578 ± 236 μmol kg",{"sup":2961},[2962],{"#text":978},{"#text":2964},") than in the Delaware River (~750-1000 μmol kg",{"sup":2966},[2967],{"#text":978},{"#text":1316},{"xref":2970,":@":2973},[2971],{"#text":2972},"Joesoef et al., 2017",{"@_ref-type":920,"@_rid":2974},"B24",{"#text":2976},"). An analysis of the relationship between seasonal discharge and the resulting acidification of Delaware Bay showed that high discharge decreased both DIC and TA and increased the DIC/TA ratio (",{"xref":2978,":@":2980},[2979],{"#text":2972},{"@_ref-type":920,"@_rid":2974},{"#text":2982},"). This directly contrasts with observations in LIS, wherein the DIC/TA ratio was lower under high-discharge conditions due to a decrease in DIC, but no significant change in TA. ",{"xref":2984,":@":2987},[2985],{"#text":2986},"Joesoef et al. (2017)",{"@_ref-type":920,"@_rid":2974},{"#text":2989}," suggested that DIC/TA increased under high-flow conditions in Delaware Bay because of enhanced uptake of soil organic matter and reduced CO",{"sub":2991},[2992],{"#text":878},{"#text":2994}," outgassing. This contrast points to differing hydrodynamic and biogeochemical processes in LIS than those observed for Delaware Bay, which should be investigated in a pan-watershed approach to further understanding of LIS acidification dynamics.",{"#text":809},{"p":2997},[2998,3000,3006,3008,3014,3016,3019,3020,3026,3028,3031,3033,3036,3037,3041,3043,3048,3050,3053,3055,3058,3060,3063],{"#text":2999},"The Louisiana Shelf of the Gulf of Mexico undergoes seasonal hypoxia due to agricultural nutrient pollution in the Mississippi River watershed (",{"xref":3001,":@":3004},[3002],{"#text":3003},"Rabalais and Turner, 2019",{"@_ref-type":920,"@_rid":3005},"B36",{"#text":3007},"). While subsurface acidification is prevalent in these coastal waters (",{"xref":3009,":@":3012},[3010],{"#text":3011},"Wang et al., 2020",{"@_ref-type":920,"@_rid":3013},"B50",{"#text":3015},"), the high alkalinity of the Mississippi River (~2400 μmol kg",{"sup":3017},[3018],{"#text":978},{"#text":1316},{"xref":3021,":@":3024},[3022],{"#text":3023},"Savoie et al., 2022",{"@_ref-type":920,"@_rid":3025},"B38",{"#text":3027},") provides resilience against acidification. Despite similar eutrophic and low-oxygen conditions in the Gulf of Mexico as in LIS, the associated changes to pH and Ω",{"sub":3029},[3030],{"#text":884},{"#text":3032}," are less dramatic than in LIS due to alkaline river water input and warmer waters that hold less CO",{"sub":3034},[3035],{"#text":878},{"#text":952},{"xref":3038,":@":3040},[3039],{"#text":2039},{"@_ref-type":920,"@_rid":2041},{"#text":3042},"). Due to the high alkalinity of the Mississippi River, ",{"xref":3044,":@":3047},[3045],{"#text":3046},"Savoie et al. (2022)",{"@_ref-type":920,"@_rid":3025},{"#text":3049}," observed that under high-flow conditions (opening of a spillway), surface water TA and Ω",{"sub":3051},[3052],{"#text":884},{"#text":3054}," increased in the Mississippi Sound, while subsurface Ω",{"sub":3056},[3057],{"#text":884},{"#text":3059}," decreased in association with stratification and hypoxia. In our observations in WLIS associated with increased Housatonic River discharge, we observed similar surface water dynamics. However, TA and Ω",{"sub":3061},[3062],{"#text":884},{"#text":3064}," were higher throughout the water column in WLIS. This divergence may be attributed to the greater depth of LIS (~40m compared to 4m in the Mississippi Sound) and its partially well-mixed characteristics, especially during the multiple storm events of summer 2021 which brought both increased precipitation and winds.",{"#text":809},{"p":3067},[3068],{"#text":3069},"Comparisons of LIS to Delaware Bay and the Gulf of Mexico provide context to inform future studies, despite clear differences between the estuaries. For example, the decrease in bottom water DIC/TA under conditions of high freshwater input appears unique to western LIS among these estuaries.",{"#text":893},{"@_id":3072},"s4_2",{"#text":893},{"sec":3075,":@":3102},[3076,3077,3081,3082,3086,3087,3096,3097,3101],{"#text":1135},{"title":3078},[3079],{"#text":3080},"4.3 Conclusions and recommendations for future work",{"#text":809},{"p":3083},[3084],{"#text":3085},"In this study, we demonstrated seasonal and interannual variations in carbonate chemistry dynamics through observations of TA and DIC across LIS from 2020-2022 on monthly to seasonal intervals. Both TA and DIC were highly correlated to salinity and increased from the head to the mouth of LIS. Seasonal trends were dependent on river discharge conditions. Generally, TA was highest in the fall and winter and decreased to a minimum during spring and early summer. DIC was high and well-mixed during winter but had a strong vertical gradient in the summer due to surface productivity and subsurface respiration.",{"#text":809},{"p":3088},[3089,3091,3094],{"#text":3090},"The sampling frequency employed here captured the contrast between two drought years with low river discharge (2020 and 2022) and one year with anomalously high precipitation and river discharge (2021). While late summer hypoxia dynamics in WLIS were relatively similar among all three sampling years, coincident acidification was greatest under low-flow conditions. During high-flow conditions, the DIC/TA ratio of the Housatonic River was lower, estuarine residence time decreased, and WLIS was better buffered against pH and Ω",{"sub":3092},[3093],{"#text":884},{"#text":3095}," decreases related to microbial respiration.",{"#text":809},{"p":3098},[3099],{"#text":3100},"Late summer and autumn river discharge in the northeast US is expected to decrease in the coming decades, which may decrease the summertime buffering capacity of WLIS and increase estuarine residence time, leaving the estuary more vulnerable to acidification. It is unclear why a higher river discharge rate decreased riverine DIC but not TA. This motivates more detailed studies of the carbonate chemistry of the open LIS and its freshwater endmembers in relation to hypoxia dynamics as the physical and biological dynamics of the estuary change with time.",{"#text":893},{"@_id":3103,"@_sec-type":3104},"s4_3","conclusions",{"#text":896},{"@_id":3107,"@_sec-type":3108},"s4","discussion",{"#text":896},{"sec":3111,":@":3123},[3112,3113,3117,3118,3122],{"#text":893},{"title":3114},[3115],{"#text":3116},"Data availability statement",{"#text":893},{"p":3119},[3120],{"#text":3121},"The raw data supporting the conclusions of this article will be made available by the authors, without undue reservation.",{"#text":896},{"@_id":3124,"@_sec-type":3125},"s5","data-availability",{"#text":896},{"sec":3128,":@":3140},[3129,3130,3134,3135,3139],{"#text":893},{"title":3131},[3132],{"#text":3133},"Author contributions",{"#text":893},{"p":3136},[3137],{"#text":3138},"LB: Conceptualization, Data curation, Formal analysis, Investigation, Methodology, Validation, Visualization, Writing – original draft, Writing – review & editing. PV: Conceptualization, Funding acquisition, Project administration, Resources, Supervision, Writing – review & editing. MM: Data curation, Investigation, Methodology, Writing – review & editing. MW: Conceptualization, Funding acquisition, Project administration, Resources, Supervision, Writing – review & editing. JV: Conceptualization, Funding acquisition, Project administration, Resources, Supervision, Writing – review & editing.",{"#text":896},{"@_id":3141,"@_sec-type":3142},"s6","author-contributions",{"#text":3144},"\n  ",[],[3147,3158,3170,3184,3198,3212,3225],{"title":3116,"order":387,"content":3148},[3149,3150,3153,3154,3157],{"#text":893},{"title":3151},[3152],{"#text":3116},{"#text":893},{"p":3155},[3156],{"#text":3121},{"#text":896},{"title":3133,"order":3159,"content":3160},3,[3161,3162,3165,3166,3169],{"#text":893},{"title":3163},[3164],{"#text":3133},{"#text":893},{"p":3167},[3168],{"#text":3138},{"#text":896},{"title":3171,"order":3172,"content":3173},"Funding",5,[3174,3175,3178,3179,3183],{"#text":893},{"title":3176},[3177],{"#text":3171},{"#text":893},{"p":3180},[3181],{"#text":3182},"The author(s) declare financial support was received for the research, authorship, and/or publication of this article. This work was supported by EPA-LISS grant LISS01719 (PV, JV, and MW). The first author LB was also supported by NSF Grants #2049991 and 2227313 (PV) and the University of Connecticut Marine Sciences Department.",{"#text":896},{"title":3185,"order":3186,"content":3187},"Acknowledgments",6,[3188,3189,3192,3193,3197],{"#text":893},{"title":3190},[3191],{"#text":3185},{"#text":893},{"p":3194},[3195],{"#text":3196},"The authors would like to express immense gratitude to the CT-DEEP water quality crew: Matthew Lyman, Katie O’Brien-Clayton, Tommy Seda, and seasonal employees for collecting samples during COVID-restricted surveys and for support during surveys that the authors attended. We also thank Dr. Claudia Koerting of the UConn SMALER facility for assistance with analyzing nutrient and DIC samples.",{"#text":896},{"title":3199,"order":3200,"content":3201},"Conflict of interest",8,[3202,3203,3206,3207,3211],{"#text":893},{"title":3204},[3205],{"#text":3199},{"#text":893},{"p":3208},[3209],{"#text":3210},"The authors declare that the research was conducted in the absence of any commercial or financial relationships that could be construed as a potential conflict of interest.",{"#text":896},{"title":3213,"order":625,"content":3214},"Publisher’s note",[3215,3216,3219,3220,3224],{"#text":893},{"title":3217},[3218],{"#text":3213},{"#text":893},{"p":3221},[3222],{"#text":3223},"All claims expressed in this article are solely those of the authors and do not necessarily represent those of their affiliated organizations, or those of the publisher, the editors and the reviewers. Any product that may be evaluated in this article, or claim that may be made by its manufacturer, is not guaranteed or endorsed by the publisher.",{"#text":896},{"title":3226,"order":3227,"content":3228},"Supplementary material",14,[3229,3230,3233,3234,3243,3244,3249],{"#text":893},{"title":3231},[3232],{"#text":3226},{"#text":893},{"p":3235},[3236,3238],{"#text":3237},"The Supplementary Material for this article can be found online at: ",{"ext-link":3239,":@":3242},[3240],{"#text":3241},"https://www.frontiersin.org/articles/10.3389/fmars.2024.1398087/full#supplementary-material",{"@_ext-link-type":850,"@_xmlns:xlink":1220,"@_xlink:href":3241},{"#text":893},{"supplementary-material":3245,":@":3246},[],{"@_xlink:href":3247,"@_id":1238,"@_mimetype":3248},"DataSheet_1.docx","application/vnd.openxmlformats-officedocument.wordprocessingml.document",{"#text":896},[3251],{"title":3252,"id":3253,"references":3254},"References","h7",[3255,3337,3468,3609,3739,3815,3908,3983,4079,4154,4236,4348,4489,4600,4737,4776,4814,4903,5041,5113,5200,5272,5362,5466,5570,5699,5834,5870,5981,6039,6086,6220,6259,6299,6499,6581,6657,6725,6866,6956,7080,7183,7222,7335,7380,7421,7469,7542,7675,7791,7912,8000,8073,8155,8282,8378],{"content":3256,"id":1033,"index":19,"authors":3334,"title":3303,"source":3308,"volume":3312,"year":3298,"fpage":3317,"lpage":3322,"doi":3328,"pmid":19},[3257,3258,3333],{"#text":809},{"citation":3259,":@":3331},[3260,3261,3294,3295,3299,3300,3304,3305,3309,3313,3314,3318,3319,3323,3325],{"#text":803},{"person-group":3262,":@":3292},[3263,3264,3277,3278,3291],{"#text":1209},{"name":3265},[3266,3267,3271,3272,3276],{"#text":2163},{"surname":3268},[3269],{"#text":3270},"Anderson",{"#text":2163},{"given-names":3273},[3274],{"#text":3275},"T. H.",{"#text":1209},{"#text":1209},{"name":3279},[3280,3281,3285,3286,3290],{"#text":2163},{"surname":3282},[3283],{"#text":3284},"Taylor",{"#text":2163},{"given-names":3287},[3288],{"#text":3289},"G. T.",{"#text":1209},{"#text":803},{"@_person-group-type":3293},"author",{"#text":952},{"year":3296},[3297],{"#text":3298},"2001",{"#text":1457},{"article-title":3301},[3302],{"#text":3303},"Nutrient pulses, plankton blooms, and seasonal hypoxia in western Long Island Sound",{"#text":2489},{"source":3306},[3307],{"#text":3308},"Estuaries",{"volume":3310},[3311],{"#text":3312},"24",{"#text":1316},{"fpage":3315},[3316],{"#text":3317},"228",{"#text":2441},{"lpage":3320},[3321],{"#text":3322},"243",{"#text":3324},". doi: ",{"pub-id":3326,":@":3329},[3327],{"#text":3328},"10.2307/1352947",{"@_pub-id-type":3330},"doi",{"@_citation-type":3332},"journal",{"#text":893},[3335,3336],{"surname":3270,"givenNames":3275},{"surname":3284,"givenNames":3289},{"content":3338,"id":998,"index":19,"authors":3461,"title":3444,"source":613,"volume":3452,"year":3439,"fpage":19,"lpage":19,"doi":3457,"pmid":19},[3339,3340,3460],{"#text":809},{"citation":3341,":@":3459},[3342,3343,3434,3436,3440,3441,3445,3446,3449,3453,3454],{"#text":803},{"person-group":3344,":@":3433},[3345,3346,3359,3360,3373,3374,3387,3388,3401,3402,3415,3416,3429,3430,3432],{"#text":1209},{"name":3347},[3348,3349,3353,3354,3358],{"#text":2163},{"surname":3350},[3351],{"#text":3352},"Brod