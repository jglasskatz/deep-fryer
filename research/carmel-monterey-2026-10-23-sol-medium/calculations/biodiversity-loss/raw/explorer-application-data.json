STRETCH","width":"STRETCH"},"vCenter":false,"hCenter":false}}},"order":["0"]}},"exbVersion":"1.21.0","mainSizeMode":"LARGE","theme":"themes/default/","forBuilderAttributes":{"lockLayout":false,"viewPortSize":{"LARGE":{"width":1440,"height":900}}},"template":"blankfullscreen","attributes":{"portalUrl":"https://CAnature.maps.arcgis.com"},"widgets":{"widget_1":{"uri":"widgets/common/embed/","version":"1.21.0","label":"Summary View Dashboard","config":{"embedType":"url","expression":"<p>https://canature.maps.arcgis.com/apps/dashboards/92579a9f1711430f8352311978c16250#</p>","enableLabel":false},"id":"widget_1","useDataSources":[]},"widget_3":{"uri":"widgets/common/text/","version":"1.21.0","label":"Text 1","config":{"text":"<p style=\"text-align: center;\"><strong style=\"color: var(--dark-800); font-size: 26px;\">Welcome to the Conserved Areas Explorer</strong></p>","style":{"verticalAlign":"start","wrap":true}},"id":"widget_3"},"widget_4":{"uri":"widgets/common/text/","version":"1.21.0","label":"Text 2","config":{"text":"<ul><li><a href=\"https://storymaps.arcgis.com/stories/3e501348c1f940a892850798fea7702e\" target=\"_blank\" data-uniqueid=\"7bc06521_4f69_5d76_cbeb_ca740c795513\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fstorymaps.arcgis.com%2Fstories%2F3e501348c1f940a892850798fea7702e%22%2C%22expression%22%3Anull%7D\" style=\"font-size: 18px;\">Click here to view the application User Guide</a></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">30x30 sets California on the path to conserving 30% of California’s lands and waters by 2030. This dashboard brings together conservation successes from across the state, tallies their contributions towards 30x30 goals, and enables exploration of data being used to track this progress. </span></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">When you close this window, you’ll be able to see the current status including lands that are considered conserved under the definitions set by 30x30. </span></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">The definition of conservation is based upon USGS GAP Codes. Gap Codes 1 and 2 are considered conserved, while 3 and 4 are not. For details on gap codes follow this </span><a href=\"https://canature.maps.arcgis.com/sharing/rest/content/items/8dbef730937f4435b2ce1df8fe742287/data\" target=\"_blank\" data-uniqueid=\"e1674300_9589_04e6_88a2_0e216872faf5\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fcanature.maps.arcgis.com%2Fsharing%2Frest%2Fcontent%2Fitems%2F8dbef730937f4435b2ce1df8fe742287%2Fdata%22%2C%22expression%22%3Anull%7D\" style=\"font-size: 18px;\"><strong>link</strong></a><span style=\"font-size: 18px;\">. </span></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">Click on the charts and map within the </span><strong style=\"font-size: 18px;\">Overview </strong><span style=\"font-size: 18px;\">dashboard that you’ll go to first to explore the currently conserved lands.  </span></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">To explore further, switch to the </span><strong style=\"font-size: 18px;\">Detailed Terrestrial </strong><span style=\"font-size: 18px;\">and </span><strong style=\"font-size: 18px;\">Marine Views</strong><span style=\"font-size: 18px;\"> by clicking on them at the top of the screen.  </span></li></ul>","style":{"verticalAlign":"start","wrap":true},"tooltip":{"name":"","parts":[{"type":"STRING","exp":"\"\""}]}},"id":"widget_4"},"widget_5":{"uri":"widgets/common/embed/","version":"1.21.0","label":"Detailed View Dashboard","config":{"embedType":"url","expression":"<p>https://canature.maps.arcgis.com/apps/dashboards/aebf25e7b1e642ed85d9a50ef83380e9#</p>","enableLabel":false},"id":"widget_5","useDataSources":[]},"widget_8":{"uri":"widgets/common/button/","version":"1.6.0","label":"Help button","config":{"functionConfig":{"icon":{"data":"${appResourceUrl}/images/icon_picker_in_setting/1625850820954.png","position":"LEFT"},"linkParam":{"linkType":"DIALOG","value":"dialog_3"},"text":"","toolTip":"Click here for instructions","toolTipExpression":null},"styleConfig":{"customStyle":{"regular":{"background":{"color":"#0c5927","fillType":"fill"},"border":{"type":"solid","color":"rgba(0,0,0,0)","width":"0px"},"text":{"color":"#ffffff","size":"16px"},"borderRadius":{"number":[0],"unit":"px"},"iconProps":{"color":"#181818","size":16}},"hover":{"background":{"color":"#0c5927","fillType":"fill"},"border":{"type":"solid","width":"undefinedpx"},"text":{"color":"var(--secondary-900)","size":"16px"},"borderRadius":{"number":[0],"unit":"px"},"iconProps":{"size":16}}},"useCustom":true}},"id":"widget_8","useDataSources":[],"useDataSourcesEnabled":false,"style":{"border":{"type":"dashed","color":"rgba(0,0,0,0)","width":"0px"}}},"widget_12":{"uri":"widgets/common/button/","version":"1.5.0","label":"Button 1 copy","config":{"functionConfig":{"icon":{"data":"${appResourceUrl}/images/icon_picker_in_setting/1625850820954.png","position":"LEFT"},"textExpression":{"name":"","parts":[{"type":"STRING","exp":"\"Help\""}]},"toolTipExpression":{"name":"","parts":[{"type":"STRING","exp":"\"Help\""}]},"linkParam":{"linkType":"DIALOG","value":"dialog_2"}},"styleConfig":{"customStyle":{"regular":{"background":{"color":"rgba(0,0,0,0)","fillType":"fill"},"border":{"type":"solid","color":"#c5c5c5","width":"1px"},"text":{"color":"#ffffff","size":"16px"},"borderRadius":{"unit":"px","number":[2,2,2,2]},"iconProps":{"color":"#181818","size":14}},"hover":{"background":{"color":"#0c5927","fillType":"fill"},"border":{"type":"solid","width":"undefinedpx"},"text":{"color":"var(--secondary-900)","size":"16px"},"borderRadius":{"unit":"px","number":[2,2,2,2]},"iconProps":{"size":16}}},"useCustom":true}},"id":"widget_12","useDataSources":[],"useDataSourcesEnabled":true},"widget_21":{"uri":"widgets/common/text/","version":"1.21.0","label":"Text 8","config":{"text":"<p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><strong style=\"color: rgb(255, 255, 255); font-size: 22px;\">Overview Dashboard Information</strong></p>","style":{"verticalAlign":"start","wrap":true},"tooltip":{"name":"","parts":[{"type":"STRING","exp":"\"\""}]}},"id":"widget_21","style":{"background":{"color":"#19386d","fillType":"fit","image":{"url":""}}}},"widget_22":{"uri":"widgets/common/text/","version":"1.21.0","label":"Text 9","config":{"text":"<ul><li><span style=\"font-size: 18px;\">To close this window click anywhere outside of it.  </span></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">30x30 sets California on the path to conserving 30% of California’s lands and coastal waters by 2030. This dashboard brings together conservation success stories from across the state, tallies their contributions towards 30x30 goals, and enables you to </span><a href=\"https://canature.maps.arcgis.com/home/item.html?id=bab1a4b4b5724ea38aa88b6673b65fb3\" target=\"_blank\" data-uniqueid=\"84a86e0f_6911_3d31_d787_c036c89fc266\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fcanature.maps.arcgis.com%2Fhome%2Fitem.html%3Fid%3Dbab1a4b4b5724ea38aa88b6673b65fb3%22%2C%22expression%22%3Anull%7D\" style=\"font-size: 18px;\">explore the data</a><span style=\"font-size: 18px;\"> being used to track this progress. </span></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">The definition of conservation is based upon the </span><a href=\"https://canature.maps.arcgis.com/sharing/rest/content/items/8dbef730937f4435b2ce1df8fe742287/data\" target=\"_blank\" data-uniqueid=\"53858ad8_6436_6a9a_fb24_e230088a3d90\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fcanature.maps.arcgis.com%2Fsharing%2Frest%2Fcontent%2Fitems%2F8dbef730937f4435b2ce1df8fe742287%2Fdata%22%2C%22expression%22%3Anull%7D\" style=\"font-size: 18px;\">USGS’s GAP Codes</a><span style=\"font-size: 18px;\">. Gap Codes 1 and 2 are considered conserved, while 3 and 4 are not.  </span></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">Conservation Categories 1 and 2 mirror the US Geological Survey's GAP definitions. GAP codes 1 and 2 reflect an emphasis on biodiversity conservation. GAP 3 is mixed land-use with some biodiversity consideration, but insufficient to be categorized as conserved. GAP 4 indicates protections from intensive development. GAP 4 areas may be conserved as open space, for use as agriculture, or local parks for instance, but have no known biodiversity management goals  </span></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">Click on the charts and map within the Overview dashboard to begin exploring lands that are presently conserved.  </span></li></ul><p><br></p><ul><li class=\"ql-indent-1\"><span style=\"font-size: 18px;\">In the bar chart, click on the GAP 1 column to update the dashboard to show how much of California has a GAP Code of 1 and where those locations are. </span></li></ul><p class=\"ql-indent-1\"><br></p><ul><li class=\"ql-indent-1\"><span style=\"font-size: 18px;\">Then click on the column again to restore the GAP 2 areas.  </span></li></ul><p class=\"ql-indent-1\"><br></p><ul><li class=\"ql-indent-1\"><span style=\"font-size: 18px;\">Zoom and pan in the map to navigate. </span></li></ul><p class=\"ql-indent-1\"><br></p><ul><li class=\"ql-indent-1\"><span style=\"font-size: 18px;\">A tool at the upper right of the map provides the ability to search for an address or location of interest, such as “Yosemite National Park” </span></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">The home icon will return the view to of all California. </span></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">Click on a location in the map to get more detailed information about the features at that location. </span></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">For greater context, switch to the Detailed View at the top of the screen. </span></li></ul>","style":{"verticalAlign":"start","wrap":true}},"id":"widget_22"},"widget_23":{"uri":"widgets/common/image/","version":"1.21.0","label":"Image 5","config":{"functionConfig":{"altText":"","toolTip":"","linkParam":{},"scale":"Fit","imageParam":{"url":"${appResourceUrl}/images/widget_23/1633385983928.png","originalUrl":"${appResourceUrl}/images/widget_23/1633385983928.png","fileName":"1633385983928.png","originalName":"30x30 - Vertical - Full Color.png","imgSourceType":"BY_UPLOAD","fileFormat":"image/png","originalId":"1633385983928","isUseCompress":false},"imgSourceType":"","srcExpression":null,"imageFillMode":"FIT"},"styleConfig":{}},"id":"widget_23"},"widget_26":{"uri":"widgets/common/image/","version":"1.21.0","label":"30x30 Logo","config":{"functionConfig":{"altText":"30x30 Logo","toolTip":"","linkParam":{},"scale":"Fit","imageParam":{"url":"${appResourceUrl}/images/widget_26/1636401028325.png","originalUrl":"${appResourceUrl}/images/widget_26/1636401028325.png","fileName":"1636401028325.png","originalName":"Full Wordmark - Vertical - White.png","imgSourceType":"BY_UPLOAD","fileFormat":"image/png","originalId":"1636401028325","isUseCompress":false},"imgSourceType":"","srcExpression":null,"imageFillMode":"FIT","altTextExpression":null},"styleConfig":{}},"id":"widget_26","useDataSources":[]},"widget_27":{"uri":"widgets/common/text/","version":"1.21.0","label":"Title","config":{"text":"<p style=\"text-align: center; line-height: 2;\"><strong style=\"background-color: rgba(0, 0, 0, 0); color: rgb(255, 255, 255); font-size: 26px;\">Conserved Areas Explorer</strong></p>","style":{"verticalAlign":"start","wrap":true}},"id":"widget_27"},"widget_28":{"uri":"widgets/common/menu/","version":"1.21.0","label":"Menu","config":{"type":"nav","menuStyle":"pills","vertical":false,"advanced":true,"standard":{"gap":"0px","showText":true,"showIcon":false,"iconPosition":"start"},"variant":{"size":{"fontSize":"0.875rem","lineHeight":1.5,"paddingX":"1rem","paddingY":"0.25rem"},"gutter":"0.25rem","icon":{"spacing":"0.5rem"},"root":{"borderRadius":"50rem"},"item":{"default":{"color":"#ffffff","border":{"width":"0px"},"borderRadius":"6.25rem","icon":{"size":"14px"},"size":"16px","bg":"#0f2e4f"},"hover":{"color":"#5aa946","borderRadius":"6.25rem","icon":{"color":"var(--primary)","size":"14px"},"size":"16px"},"active":{"color":"#0f2e4f","bg":"#ffffff","borderRadius":"6.25rem","icon":{"color":"var(--white)","size":"14px"},"size":"16px"},"disabled":{"color":"#989898","shadow":"none","borderRadius":"6.25rem"}}},"paper":{"bg":"#f0f0f0","color":"#050505","paddingX":0,"paddingY":0,"border":{"width":0,"color":"transparent"}}},"id":"widget_28"},"widget_31":{"uri":"widgets/common/embed/","version":"1.21.0","label":"Embed 1","config":{"embedType":"url","expression":"<p>https://canature.maps.arcgis.com/apps/dashboards/4745fd5684a34c8c88020d485807eb77</p>","enableLabel":false},"id":"widget_31","useDataSources":[]},"widget_32":{"uri":"widgets/common/image/","version":"1.21.0","label":"Image 6","config":{"functionConfig":{"altText":"","toolTip":"","linkParam":{},"scale":"Fit","imageParam":{"url":"${appResourceUrl}/images/widget_26/1636401028325.png","originalUrl":"${appResourceUrl}/images/widget_26/1636401028325.png","fileName":"1636401028325.png","originalName":"Full Wordmark - Vertical - White.png","imgSourceType":"BY_UPLOAD","fileFormat":"image/png","originalId":"1636401028325","isUseCompress":false},"imageDisplayQualityMode":"ORIGINAL","imgSourceType":"","srcExpression":null,"imageFillMode":"FIT"},"styleConfig":{}},"id":"widget_32"},"widget_33":{"uri":"widgets/common/text/","version":"1.21.0","label":"Text 10","config":{"text":"<p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><strong style=\"font-size: 22px; color: rgb(255, 255, 255);\">Terrestrial Detailed Dashboard Information</strong></p>","style":{"verticalAlign":"start","wrap":true},"tooltip":{"name":"","parts":[{"type":"STRING","exp":"\"\""}]}},"id":"widget_33","style":{"background":{"color":"#19386d","fillType":"fit","image":{"url":""}}}},"widget_34":{"uri":"widgets/common/text/","version":"1.21.0","label":"Text 11","config":{"text":"<p><span style=\"font-size: 18px;\">To close this window click anywhere outside of it. </span></p><p><br></p><p><strong style=\"font-size: 18px;\">Filters </strong></p><ul><li><span style=\"font-size: 18px;\">By default, all conservation easements are included. Click on \"easements only\" to show only areas with a conservation easement. </span></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">Click on the State Selection to show the currently conserved lands. Use the Custom Selection option to expand the available options to include Conservation Categories 3 and 4. </span></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">Use the County, CA Nature Regions, and Ecoregions to filter down to a particular area of interest. </span></li></ul><p><br></p><p><strong style=\"font-size: 18px;\">Acres by Agency or Access (bar chart) </strong></p><ul><li><span style=\"font-size: 18px;\">Click on the Management Agency Level or Access Type tabs to explore who owns the land, manages it, and whether it affords public access.  </span></li></ul><p><br></p><p><strong style=\"font-size: 18px;\">Protected Area (pie chart) </strong></p><ul><li><span style=\"font-size: 18px;\">Use the tabs for State, County, CA Nature Region, and Ecoregion to see a summary of the current selection’s contribution to meeting the goal of 30x30. </span></li></ul>","style":{"verticalAlign":"start","wrap":true}},"id":"widget_34"},"widget_35":{"uri":"widgets/common/image/","version":"1.21.0","label":"Image 7","config":{"functionConfig":{"altText":"","toolTip":"","linkParam":{},"scale":"Fit","imageParam":{"url":"${appResourceUrl}/images/widget_26/1636401028325.png","originalUrl":"${appResourceUrl}/images/widget_26/1636401028325.png","fileName":"1636401028325.png","originalName":"Full Wordmark - Vertical - White.png","imgSourceType":"BY_UPLOAD","fileFormat":"image/png","originalId":"1636401028325","isUseCompress":false},"imageDisplayQualityMode":"ORIGINAL","imgSourceType":"","srcExpression":null,"imageFillMode":"FIT"},"styleConfig":{}},"id":"widget_35"},"widget_37":{"uri":"widgets/common/text/","version":"1.21.0","label":"Text 12","config":{"text":"<p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><strong style=\"color: rgb(255, 255, 255); font-size: 22px;\">Marine Detailed Dashboard Information</strong></p>","style":{"verticalAlign":"start","wrap":true},"tooltip":{"name":"","parts":[{"type":"STRING","exp":"\"\""}]}},"id":"widget_37","style":{"background":{"color":"#19386d","fillType":"fit","image":{"url":""}}}},"widget_38":{"uri":"widgets/common/text/","version":"1.21.0","label":"Text 13","config":{"text":"<p><span style=\"font-size: 18px;\">To close this window click anywhere outside of it. </span></p><p><br></p><p><strong style=\"font-size: 18px;\">Filters </strong></p><ul><li><span style=\"font-size: 18px;\">By default, All State Marine Protected Areas (MPAs) are selected. These represent area considered to be 30x30 Conserved Areas. </span></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">National Marine Sanctuaries (NMS), areas of overlapping MPA and NMS designations, and the total area in either an MPA, NMS, or both are available. </span></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">You may also search for MPAs by name.  </span></li></ul><p><br></p><ul><li><span style=\"font-size: 18px;\">As your selection changes, the protected area chart and percentage will update. </span></li></ul>","style":{"verticalAlign":"start","wrap":true}},"id":"widget_38"},"widget_39":{"uri":"widgets/common/image/","version":"1.21.0","label":"Image 8","config